# Plantilla para .env.production — copiar a .env.production (gitignoreado,
# ver .gitignore) y completar con valores reales antes de levantar
# docker-compose.prod.yml. NO commitear .env.production con valores reales.

# Dominio (o IP pública) del servidor. Si es un dominio real apuntando acá
# con 80/443 abiertos, Caddy pide TLS automático solo. Si es una IP/nombre
# interno, Caddy sirve HTTP plano sin intentar Let's Encrypt.
DOMAIN=

# Email de contacto para el registro ACME de Let's Encrypt (avisos de
# expiración de certificados). Puede quedar vacío si DOMAIN no es un dominio
# real todavía.
ACME_EMAIL=

# Password de Postgres en producción — generar uno nuevo, NO reusar
# "srrhh_pass" de docker-compose.yml (dev).
DB_PASSWORD=

# Secret de JWT — mínimo 32 caracteres, generar con algo como:
#   openssl rand -base64 32
# NO reusar "dev-secret-minimo-32-caracteres-cambiar" de dev.
JWT_SECRET=

# Solo completar si el frontend y la API van a vivir en dominios distintos
# (poco común con este Caddyfile, que los sirve bajo el mismo dominio).
VITE_API_URL=
