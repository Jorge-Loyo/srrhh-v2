DATABASE_URL="postgresql://srrhh_user:srrhh_pass@localhost:5432/srrhh_db"

# Opcional — orígenes permitidos por CORS, separados por coma. Vacío por
# default: Node habla con este servicio server-to-server (CORS no le aplica),
# y el frontend nunca debería llamarlo directo. Solo hace falta setear esto
# si en algún momento se necesita pegarle desde un navegador (debug, etc.).
CORS_ORIGINS=""
