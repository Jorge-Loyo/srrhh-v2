// =============================================================================
// SRRHH v2 — Schema de Base de Datos
// Sistema de Recursos Humanos - Gobierno de la Ciudad de Buenos Aires
// =============================================================================
// Fuente de verdad del modelo de datos. Ver Doc/Contrato_Datos.md
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum EstadoCargo {
  vigente
  no_vigente
  validacion_vacante
}

enum EstadoSnapshot {
  procesando
  pendiente
  aprobado
  rechazado
  error
}

enum TipoDiff {
  nuevo
  modificado
  eliminado
}

enum TipoConcurso {
  cph
  ceetps
  sin_concurso
}

// S14-1: motivo por el que se inicia un concurso desde una solicitud de alta
// (ver Concurso.motivoConcurso). No confundir con el MotivoConcurso legacy
// de @srrhh/types (baja/ampliacion/cobertura_pou/jefatura/otro) — ese es un
// concepto distinto y sin uso hoy.
enum MotivoConcurso {
  nuevo_cargo
  alta_por_baja
}

enum EstadoConcursoCph {
  no_iniciado
  activo
  finalizado
  suspendido
}

enum EstadoConcursoCeetps {
  sin_autorizar
  autorizado
  en_proceso
  finalizado
  desierto
}

// RBAC dinámico — reemplaza el enum fijo viejo (ver Role/Permiso/RolePermiso más abajo,
// junto al modelo Usuario). El enum se elimina; los 6 valores originales viven ahora como
// filas sembradas en `roles` (Role.esSistema = true).

// =============================================================================
// TABLAS DE REFERENCIA (Catalogos)
// =============================================================================

model Hospital {
  id                  String   @id @default(uuid()) @db.Uuid
  sigla               String   @unique @db.VarChar(20)
  nombre              String   @db.VarChar(200)
  universoTotalizador String?  @map("universo_totalizador") @db.VarChar(100)
  tipo                String?  @db.VarChar(100)
  monovalencia        String?  @db.VarChar(100)
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  cargos           Cargo[]
  concursos        Concurso[]
  concursosCph     ConcursoCph[]
  concursosCeetps  ConcursoCeetps[]
  usuarios         Usuario[]
  bajas            Baja[]
  solicitudesAlta  SolicitudAlta[]

  @@map("hospitales")
}

// Estructura jerárquica de unidades organizativas por efector (hospital) y por
// sección administrativa (Nivel Central, Atención Primaria). Migrada 1:1 desde
// la tabla `organigramas` de la app vieja (dotacion-rrhh) — ver
// Doc/Planificacion/Sprints/POST_SPRINT_14_migracion_legacy_organigrama.md
// para el origen del dump y el script de import (scripts/import_organigrama.mjs).
// Es un árbol estático (no cambia con el padrón semanal): la app arma el árbol
// desde acá y le cruza encima, en runtime, quién ocupa cada nodo hoy (join por
// `codigoReparticion` contra `Cargo.codigoRepa`) — ver apps/api/src/modules/organigrama.
// `sigla` no es FK dura a Hospital (igual que en la app vieja, ahí también era
// "lógica"): hay nodos de nivel Ministerio/Área que no corresponden a ningún
// hospital puntual.
model Organigrama {
  id                  String  @id @default(uuid()) @db.Uuid
  lvl                 Int
  tipo                String  @db.VarChar(50)
  codigoReparticion   String  @unique @map("codigo_reparticion") @db.VarChar(20)
  universoTotalizador String? @map("universo_totalizador") @db.VarChar(100)
  regimenEmpleo       String? @map("regimen_empleo") @db.VarChar(200)
  descRep             String? @map("desc_rep") @db.VarChar(200)
  sigla               String  @db.VarChar(20)
  padre               String? @db.VarChar(100)
  path                String  @db.VarChar(600)
  pathNombres         String  @map("path_nombres") @db.VarChar(1200)

  @@index([sigla])
  @@index([padre])
  @@index([universoTotalizador])
  @@map("organigramas")
}

// Historial de cargas del Excel de estructura (módulo Árbol, solo admin).
// Cada vez que se sube un Excel nuevo se registra acá para trazabilidad.
model OrganigramaUpload {
  id          String   @id @default(uuid()) @db.Uuid
  filename    String   @db.VarChar(255)
  filas       Int
  subidoPorId String?  @map("subido_por_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  subidoPor Usuario? @relation("OrganigramaUploadSubidoPor", fields: [subidoPorId], references: [id])

  @@map("organigrama_uploads")
}

// Resumen de evolución histórica de dotación por escalafón.
// Una fila por (fecha, escalafon) — se inserta al aprobar cada snapshot
// de padrón (padron.service.ts, aprobarSnapshotService). El escalafón
// viene de cargo_id → escalafones.nombre (nombre canónico, no el texto
// desnormalizado de padron_historico que tiene variantes históricas).
model KpisDotacionSnapshot {
  fecha     DateTime @db.Date
  escalafon String   @db.VarChar(100)
  personas  Int

  @@id([fecha, escalafon])
  @@index([fecha])
  @@map("kpis_dotacion_snapshot")
}

// Resumen de dotación (personal necesario/ocupado) por hospital, perfil y
// especialidad — foto mensual cargada a mano desde el Excel "Ocupacion_POU"
// que emite Recursos Humanos. Migrado 1:1 desde la tabla `pou` de la app
// vieja (dotacion-rrhh) — ver Doc/ESQUEMA_BASE_DE_DATOS.md sección 8.3 ahí.
// OJO — nombre superpuesto a propósito distinto de otro concepto ya existente
// en v2: esto NO tiene relación con `ModalidadPuesto.pou` (el campo
// guardia/planta de un Cargo individual). Esta tabla es un conteo agregado
// por puesto de trabajo, no un dato de ningún Cargo puntual.
// Sin período/histórico por decisión explícita (a diferencia de la app
// vieja, que sí guardaba un historial mensual): cada carga de Excel reemplaza
// la tabla entera — mismo patrón que Organigrama/Árbol arriba.
model Pou {
  id               String  @id @default(uuid()) @db.Uuid
  sigla            String  @db.VarChar(10)
  descripcionSigla String? @map("descripcion_sigla") @db.VarChar(100)
  perfil           String  @db.VarChar(50)
  especialidad     String  @db.VarChar(100)
  dotacionDiaria   Int?    @map("dotacion_diaria")
  dotacionSem      Int?    @map("dotacion_sem")
  dotacionTotal    Int?    @map("dotacion_total")
  activos          Int?
  tecnicos         Int?
  vacantes         Int?

  @@unique([sigla, perfil, especialidad])
  @@index([sigla])
  @@map("pou")
}

model Escalafon {
  id        String   @id @default(uuid()) @db.Uuid
  // Código canónico corto: 22, 37, 83, etc. (CODIGO DE REGISTRO del Excel).
  // Cuando un escalafón tiene más de un código (ej. CPH: 22 y 37) se usa el
  // menor como código principal; los alias viven en CodigoRegistro.
  codigo    String   @unique @db.VarChar(20)
  // Nombre canónico = LITERAL CR normalizado (fuente de verdad del Excel).
  // "Carrera Administrativa" y "Nueva Carrera Administrativa" se unifican
  // en "Nueva Carrera Administrativa".
  nombre    String   @db.VarChar(100)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  codigosRegistro        CodigoRegistro[]
  cargos                 Cargo[]
  concursosCeetps        ConcursoCeetps[]
  puestosCargo           PuestoCargo[]
  solicitudesAlta        SolicitudAlta[]

  @@map("escalafones")
}

// Tabla de relación: un escalafón canónico puede tener N códigos de registro
// del Excel (ej. "Nueva Carrera Prof. Hosp" tiene códigos 22 y 37).
// Es la fuente de verdad para normalizar al procesar cada padrón:
model CodigoRegistro {
  id          String   @id @default(uuid()) @db.Uuid
  codigo      String   @unique @db.VarChar(10)
  literal     String   @db.VarChar(100)
  escalafonId String   @map("escalafon_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  escalafon Escalafon @relation(fields: [escalafonId], references: [id])
  cargos    Cargo[]
  concursosCphSolicitado ConcursoCph[] @relation("CphCodigoRegistroSolicitado")
  solicitudesAlta        SolicitudAlta[]

  @@map("codigos_registro")
}

// =============================================================================
// ENTIDADES PRINCIPALES
// =============================================================================

model Persona {
  id                    String    @id @default(uuid()) @db.Uuid
  cuil                  String    @unique @db.VarChar(11)
  numeroDoc             String?   @map("numero_doc") @db.VarChar(20)
  tipoDoc               String?   @map("tipo_doc") @db.VarChar(10)
  apellidoNombre        String    @map("apellido_nombre") @db.VarChar(200)
  fechaNacimiento       DateTime? @map("fecha_nacimiento") @db.Date
  sexo                  String?   @db.VarChar(10)
  especialidadPrincipal String?   @map("especialidad_principal") @db.VarChar(200)
  // Especialidad CPH canónica — viene de ref_especialidades_cuil tipo=cph.
  // Distinta de especialidadPrincipal (que es la del cargo actual del padrón).
  // Se popula al aprobar cada snapshot y no cambia con el cargo.
  especialidadCph       String?   @map("especialidad_cph") @db.VarChar(200)
  // S2-17: contacto y domicilio
  telefono              String?   @db.VarChar(20)
  mailPersonal          String?   @map("mail_personal") @db.VarChar(255)
  mailLaboral           String?   @map("mail_laboral") @db.VarChar(255)
  domicilio             String?   @db.VarChar(255)
  localidad             String?   @db.VarChar(150)
  provincia             String?   @db.VarChar(100)
  antiguedadDesde       DateTime? @map("antiguedad_desde") @db.Date
  activo                Boolean   @default(true)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  ocupaciones              Ocupacion[]
  concursos                Concurso[]
  concursosCphDesignado    ConcursoCph[]    @relation("PersonaDesignadaCph")
  concursosCeetpsDesignado ConcursoCeetps[] @relation("PersonaDesignadaCeetps")
  padronHistorico          PadronHistorico[]
  bajas                    Baja[]
  postulante               Postulante?
  ordenMeritoIntegrante    OrdenMeritoIntegrante[]
  juradosSorteados         MiembroJuradoSorteado[] @relation("MiembroJuradoPersona")

  @@index([numeroDoc])
  @@index([especialidadCph])
  @@map("personas")
}

model Cargo {
  id                String       @id @default(uuid()) @db.Uuid
  idSial            String       @unique @map("id_sial") @db.VarChar(50)
  // Código interno del sistema (distinto del id_sial, que es del SIAL del
  // gobierno) — nomenclatura heredada del sistema legacy dotacion-rrhh
  // (Doc/REGLAS_NEGOCIO.MD ahí, sección 3): {CARRERA}[-{TIPO}][-{MODALIDAD}]-{seq 6 dígitos},
  // ej. "CPH-POU-000056". Se genera al backfillear los cargos reales
  // (2026-08-25) y debería generarse también en una futura función de "Alta
  // de Cargo" manual — no existe todavía en este proyecto, ver
  // Doc/Planificacion/PLAN_SCRUM_2026.md.
  codigo            String?      @unique @db.VarChar(30)
  hospitalId        String       @map("hospital_id") @db.Uuid
  escalafonId       String       @map("escalafon_id") @db.Uuid
  codigoRegistroId  String?      @map("codigo_registro_id") @db.Uuid
  literalPuesto     String?      @map("literal_puesto") @db.VarChar(200)
  especialidadLegacy String?      @map("especialidad_legacy") @db.VarChar(200)
  agrupador         String?      @db.VarChar(150)
  unificadorPuesto  String?      @map("unificador_puesto") @db.VarChar(200)
  regimen           String?      @db.VarChar(50)
  // S2-17: repartición y clasificaciones SIAL
  codigoRepa        String?      @map("codigo_repa") @db.VarChar(20)
  descripcionRepa   String?      @map("descripcion_repa") @db.VarChar(200)
  codAgrupamiento   String?      @map("cod_agrupamiento") @db.VarChar(20)
  agrupamiento      String?      @db.VarChar(150)
  codFamilia        String?      @map("cod_familia") @db.VarChar(20)
  litFamilia        String?      @map("lit_familia") @db.VarChar(150)
  puestoCodigoSial  String?      @map("puesto_codigo_sial") @db.VarChar(20)
  estado            EstadoCargo  @default(vigente)
  // S8A-1: fecha en que el cargo entró al estado actual (para calcular días en estado)
  estadoDesde       DateTime?    @map("estado_desde") @db.Date
  // S7-1: trazabilidad del alta manual (RF-11/12/13)
  expediente        String?      @db.VarChar(150)
  fechaDesde        DateTime?    @map("fecha_desde") @db.Date
  createdById       String?      @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz

  // S18-1: retención y cadena
  tipoOrigen      String?   @map("tipo_origen") @db.VarChar(5)
  // 'R'   = remplazante de ejecución
  // 'TTR' = remplazante de conducción (Titular Transitorio por Reemplazo)
  // null  = cargo normal (no es remplazante)

  cargoRetenidoId String?   @map("cargo_retenido_id") @db.Uuid
  // FK al cargo que este cargo está remplazando (null si no es remplazante)

  cargoBaseId     String?   @map("cargo_base_id") @db.Uuid
  // FK al cargo base de la cadena (desnormalizado). null si este cargo ES el base

  // Período de conducción (solo TTR y cargos base de conducción)
  periodoDesde    DateTime? @map("periodo_desde") @db.Date
  periodoHasta    DateTime? @map("periodo_hasta") @db.Date
  periodoRenovado Boolean   @default(false) @map("periodo_renovado")
  fechaRenovacion DateTime? @map("fecha_renovacion") @db.Date

  // Relaciones
  hospital        Hospital        @relation(fields: [hospitalId], references: [id])
  escalafon       Escalafon       @relation(fields: [escalafonId], references: [id])
  codigoRegistro  CodigoRegistro? @relation(fields: [codigoRegistroId], references: [id])
  createdBy       Usuario?        @relation("CargosCreados", fields: [createdById], references: [id])
  ocupaciones     Ocupacion[]
  concursos       Concurso[]
  concursosCph    ConcursoCph[]
  concursosCeetps ConcursoCeetps[]
  padronHistorico PadronHistorico[]
  bajas           Baja[]
  etiquetas       EtiquetaCargo[]

  // S18-1: cadena de retención
  cargoRetenido Cargo?  @relation("CargoRemplazante", fields: [cargoRetenidoId], references: [id])
  remplazantes  Cargo[] @relation("CargoRemplazante")
  cargoBase     Cargo?  @relation("CadenaCargo", fields: [cargoBaseId], references: [id])
  cadena        Cargo[] @relation("CadenaCargo")

  @@index([hospitalId])
  @@index([escalafonId])
  @@index([estado])
  @@index([cargoBaseId])
  @@index([cargoRetenidoId])
  @@map("cargos")
}

model Ocupacion {
  id               String    @id @default(uuid()) @db.Uuid
  personaId        String    @map("persona_id") @db.Uuid
  cargoId          String    @map("cargo_id") @db.Uuid
  idSialRol             String    @unique @map("id_sial_rol") @db.VarChar(50)
  cuilYRol              String?   @map("cuil_y_rol") @db.VarChar(80)
  situacionRevista      String?   @map("situacion_revista") @db.VarChar(50)
  estadoPersona         String?   @map("estado_persona") @db.VarChar(50)
  desde                 DateTime? @db.Date
  hasta                 DateTime? @db.Date
  // S2-17: jefatura
  codigoJefaturas       String?   @map("codigo_jefaturas") @db.VarChar(10)
  jefeEscalafon         String?   @map("jefe_escalafon") @db.VarChar(50)
  documentacionJefatura String?   @map("documentacion_jefatura") @db.Text
  comentariosJefaturas  String?   @map("comentarios_jefaturas") @db.Text
  escritorio            String?   @db.VarChar(100)
  pouDesde              DateTime? @map("pou_desde") @db.Date
  documentacionPou      String?   @map("documentacion_pou") @db.Text
  // S2-17: comisión
  comision              String?   @db.VarChar(150)
  repaComision          String?   @map("repa_comision") @db.VarChar(200)
  srDocRespaldo         String?   @map("sr_doc_respaldo") @db.Text
  srComentario          String?   @map("sr_comentario") @db.Text
  crComentario          String?   @map("cr_comentario") @db.Text
  // S2-17: bloqueo
  fechaBloqueo          DateTime? @map("fecha_bloqueo") @db.Date
  bloqueoComentario     String?   @map("bloqueo_comentario") @db.Text
  bloqMotivo            String?   @map("bloq_motivo") @db.VarChar(200)
  codSituacion          String?   @map("cod_situacion") @db.VarChar(10)
  // S2-17: documentación del rol
  documentacionDelRol   String?   @map("documentacion_del_rol") @db.Text
  documentacionBaja     String?   @map("documentacion_baja") @db.Text
  // S2-17: días de guardia (una fila por día en origen → array)
  diasGuardia           String[]
  // cargo_desde / cargo_hasta: fechas del cargo en SIAL (CARGO_DESDE / CARGO_HASTA del Excel)
  cargoDesdeFecha       DateTime? @map("cargo_desde") @db.Date
  cargoHastaFecha       DateTime? @map("cargo_hasta") @db.Date
  snapshotId            String?   @map("snapshot_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  persona  Persona         @relation(fields: [personaId], references: [id])
  cargo    Cargo           @relation(fields: [cargoId], references: [id])
  snapshot PadronSnapshot? @relation(fields: [snapshotId], references: [id])

  @@index([personaId])
  @@index([cargoId])
  @@index([hasta])
  @@map("ocupaciones")
}

// =============================================================================
// PADRON SEMANAL
// =============================================================================

model PadronSnapshot {
  id             String         @id @default(uuid()) @db.Uuid
  fechaAsignada        DateTime       @unique @map("fecha_asignada") @db.Date
  filename             String         @db.VarChar(200)
  totalRegistros       Int            @map("total_registros")
  procesadoPorId       String?        @map("procesado_por") @db.Uuid
  estado               EstadoSnapshot @default(pendiente)
  aprobadoPorId        String?        @map("aprobado_por") @db.Uuid
  aprobadoAt           DateTime?      @map("aprobado_at") @db.Timestamptz
  pasoActual           String?        @map("paso_actual") @db.VarChar(100)
  errorMsg             String?        @map("error_msg") @db.Text
  // S2-16: rutas de archivos generados por el pipeline
  archivoResultadoPath String?        @map("archivo_resultado_path") @db.VarChar(500)
  archivoCalidadPath   String?        @map("archivo_calidad_path") @db.VarChar(500)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  procesadoPor    Usuario?          @relation("SnapshotProcesadoPor", fields: [procesadoPorId], references: [id])
  aprobadoPor     Usuario?          @relation("SnapshotAprobadoPor", fields: [aprobadoPorId], references: [id])
  diffs           PadronDiff[]
  ocupaciones     Ocupacion[]
  padronHistorico PadronHistorico[]
  bajasVinculadas Baja[]            @relation("BajaSnapshotVinculado")

  @@map("padron_snapshots")
}

model PadronDiff {
  id            String   @id @default(uuid()) @db.Uuid
  snapshotId    String   @map("snapshot_id") @db.Uuid
  tipo          TipoDiff
  idSialRol     String   @map("id_sial_rol") @db.VarChar(50)
  campo         String?  @db.VarChar(100)
  valorAnterior String?  @map("valor_anterior") @db.Text
  valorNuevo    String?  @map("valor_nuevo") @db.Text
  // null = pendiente decisión, true = aprobado (se crea cargo+persona+ocupación), false = rechazado (se crea sin código)
  aprobado      Boolean?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  snapshot PadronSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@map("padron_diff")
}

model PadronHistorico {
  id               String   @id @default(uuid()) @db.Uuid
  snapshotId       String   @map("snapshot_id") @db.Uuid
  fechaAsignada    DateTime @map("fecha_asignada") @db.Date
  personaId        String   @map("persona_id") @db.Uuid
  cargoId          String   @map("cargo_id") @db.Uuid
  idSialRol        String   @map("id_sial_rol") @db.VarChar(50)
  // Nullable: filas históricas de antes de S6-0 no lo tienen hasta que
  // corra el backfill (scripts/backfill-cuil-padron-historico.sql). Todo
  // registro nuevo (aprobarSnapshotService) ya lo completa siempre.
  cuil             String?  @db.VarChar(11)
  escalafon        String?  @db.VarChar(50)
  hospitalSigla    String?  @map("hospital_sigla") @db.VarChar(20)
  literalPuesto    String?  @map("literal_puesto") @db.VarChar(200)
  especialidad     String?  @db.VarChar(200)
  agrupador        String?  @db.VarChar(150)
  unificadorPuesto String?  @map("unificador_puesto") @db.VarChar(200)
  estadoPersona    String?  @map("estado_persona") @db.VarChar(50)
  situacionRevista String?  @map("situacion_revista") @db.VarChar(50)

  // Relaciones
  snapshot PadronSnapshot @relation(fields: [snapshotId], references: [id])
  persona  Persona        @relation(fields: [personaId], references: [id])
  cargo    Cargo          @relation(fields: [cargoId], references: [id])

  @@index([snapshotId])
  @@index([fechaAsignada])
  @@index([personaId])
  @@index([cargoId])
  @@index([cuil])
  @@map("padron_historico")
}

// =============================================================================
// CONCURSOS
// =============================================================================

model Concurso {
  id             String       @id @default(uuid()) @db.Uuid
  personaId      String?      @map("persona_id") @db.Uuid
  cargoId        String       @map("cargo_id") @db.Uuid
  hospitalId     String       @map("hospital_id") @db.Uuid
  // bajaId nullable: hay concursos por ampliación sin baja previa (S5-4)
  bajaId         String?      @map("baja_id") @db.Uuid
  origen         String       @db.VarChar(50)
  fechaVacante   DateTime     @map("fecha_vacante") @db.Date
  motivo         String?      @db.VarChar(200)
  expediente     String?      @db.VarChar(150)
  tipoConcurso   TipoConcurso @map("tipo_concurso")
  // S14-1: motivo tipificado por el que se inicia el concurso (distinto del
  // campo `motivo` libre de arriba) — usado cuando el concurso nace de una
  // solicitud de alta, ver notificación concurso_iniciado a sgrasv.
  motivoConcurso MotivoConcurso? @map("motivo_concurso")
  registradoPorId String?     @map("registrado_por") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  persona       Persona?         @relation(fields: [personaId], references: [id])
  cargo         Cargo            @relation(fields: [cargoId], references: [id])
  hospital      Hospital         @relation(fields: [hospitalId], references: [id])
  registradoPor Usuario?         @relation(fields: [registradoPorId], references: [id])
  concursoCph   ConcursoCph?
  concursoCeetps ConcursoCeetps?
  baja          Baja?            @relation(fields: [bajaId], references: [id])

  @@index([hospitalId])
  @@index([tipoConcurso])
  @@map("concursos")
}

model ConcursoCph {
  id                    String           @id @default(uuid()) @db.Uuid
  concursoId            String           @unique @map("concurso_id") @db.Uuid
  cargoId               String           @map("cargo_id") @db.Uuid
  hospitalId            String           @map("hospital_id") @db.Uuid
  // estado/subEstado/subEstado3: calculados por calcConcursoCph() (S4-4) en
  // cada create/PATCH, no editables directamente por el cliente (ver
  // concursos-cph.schema.ts) — se persisten igual (como el legacy) para poder
  // filtrar/indexar sin recalcular todo en cada listado. subEstado3 puede
  // desactualizarse solo con el paso del tiempo (dos ramas comparan contra
  // "hoy"), por eso el listado (S4-1) lo recalcula en SQL al filtrar en vez
  // de confiar ciegamente en el valor guardado — ver SUB_ESTADO_3_SQL_PG.
  estado                EstadoConcursoCph @default(no_iniciado)
  subEstado             String?          @map("sub_estado") @db.VarChar(50)
  subEstado3            String?          @map("sub_estado_3") @db.VarChar(50)
  especialidadSolicitada String?         @map("especialidad_solicitada") @db.VarChar(200)
  // Puesto que se solicita cubrir — distinto del puesto de la baja
  // (cargo.literalPuesto) en los casos Jefaturas/Cobertura POU. Si es null,
  // los documentos exportables asumen que es el mismo que el de la baja.
  puestoSolicitado      String?          @map("puesto_solicitado") @db.VarChar(200)
  eeBaja                String?          @map("ee_baja") @db.VarChar(150)
  fechaBaja             DateTime?        @map("fecha_baja") @db.Date
  eeConcurso            String?          @map("ee_concurso") @db.VarChar(150)
  fechaEeConcurso       DateTime?        @map("fecha_ee_concurso") @db.Date
  // IF de autorización: número de documento que se completa en la apertura
  // antes de solicitar la autorización a SGRASV.
  ifAutorizacion        String?          @map("if_autorizacion") @db.VarChar(150)
  fechaAutorizacion     DateTime?        @map("fecha_autorizacion") @db.Date
  sorteoJurado          DateTime?        @map("sorteo_jurado") @db.Date
  // Tipo de gestión del concurso: 'centralizado' (interviene SGOCDCPS y equipo
  // en la etapa 3) o 'descentralizado' (interviene un tercero). Por ahora es
  // informativo; se define en la etapa 2 (Autorización / Jurado).
  tipoGestion           String?          @map("tipo_gestion") @db.VarChar(20)
  disposicion           String?          @db.VarChar(100)
  fechaInscDesde        DateTime?        @map("fecha_insc_desde") @db.Date
  fechaInscHasta        DateTime?        @map("fecha_insc_hasta") @db.Date
  // Cierre del período de inscripción de exámenes (Etapa 3): al cerrarse, el
  // sub-estado avanza de "C — Inscripción de exámenes" a "D — Publicación
  // Examen". Se registra la fecha del cierre.
  inscripcionCerrada    Boolean          @default(false) @map("inscripcion_cerrada")
  fechaCierreInscripcion DateTime?       @map("fecha_cierre_inscripcion") @db.Date
  // Etapa 3 — cierres formales: al confirmar presentados se congela quién se
  // presentó al examen; al confirmar el orden de mérito se fija el ranking, se
  // setea fechaOrdenMerito=hoy y avanza el sub-estado a E — Orden de mérito.
  presentadosConfirmados Boolean         @default(false) @map("presentados_confirmados")
  ordenMeritoConfirmado  Boolean         @default(false) @map("orden_merito_confirmado")
  fechaExamen           DateTime?        @map("fecha_examen") @db.Date
  fechaOrdenMerito      DateTime?        @map("fecha_orden_merito") @db.Date
  fechaIfacs            DateTime?        @map("fecha_ifacs") @db.Date
  fechaInsal            DateTime?        @map("fecha_insal") @db.Date
  eeDesignacion         String?          @map("ee_designacion") @db.VarChar(150)
  cargaDocumentacion    Boolean?         @map("carga_documentacion")
  fechaAptoMedico       DateTime?        @map("fecha_apto_medico") @db.Date
  fechaIte              DateTime?        @map("fecha_ite") @db.Date
  proyectoResolucion    Boolean?         @map("proyecto_resolucion")
  resoALaFirma          Boolean?         @map("reso_a_la_firma")
  resolucionDesignacion String?          @map("resolucion_designacion") @db.VarChar(100)
  fechaResolucion       DateTime?        @map("fecha_resolucion") @db.Date
  // Código real de cargo en SIAL — se completa cuando se da de alta la nueva
  // ocupación en SIAL tras la designación (paso administrativo posterior a
  // la resolución, distinto del cargoId/idSial del cargo vacante en concurso).
  cargoSial             String?          @map("cargo_sial") @db.VarChar(50)
  dispoDesierta         String?          @map("dispo_desierta") @db.VarChar(50)
  fechaDispoDesierta    DateTime?        @map("fecha_dispo_desierta") @db.Date
  personaDesignadaId    String?          @map("persona_designada_id") @db.Uuid
  suspendido            Boolean          @default(false)
  // Campos nuevos — datos del CSV histórico y flujo completo
  ifacs                 String?          @db.VarChar(200)  // expediente IF del IFACS
  insal                 String?          @db.VarChar(200)  // expediente IF del INSAL
  // Respuesta de la persona propuesta al INSAL (Etapa 4 — no es la
  // designación oficial, esa es en Etapa 5). null = sin respuesta todavía,
  // true = aceptó el cargo. Si no acepta, no se persiste "false": se limpia
  // personaDesignadaId, vuelve a null, y el inscripto queda en
  // insalRechazados para no volver a proponerlo.
  insalAceptado         Boolean?         @map("insal_aceptado")
  // Ids de InscriptoConcurso que fueron propuestos para el INSAL y
  // rechazaron el cargo — se excluyen de la lista de elegibles del orden de
  // mérito para no volver a ofrecerlos.
  insalRechazados        String[]         @map("insal_rechazados")
  // Etapa 4 — candidato del orden de mérito reservado para el INSAL, apuntando
  // al InscriptoConcurso (NO al padrón de personas). La designación oficial
  // que sí resuelve contra el padrón es en Etapa 5 (personaDesignadaId).
  // Nullable: se limpia cuando el candidato no acepta el cargo.
  inscriptoReservadoId  String?          @map("inscripto_reservado_id") @db.Uuid
  // Etapa 5 — validación contra el padrón: true cuando el padrón trae a la
  // persona con un id SIAL rol cuyo cargo coincide en carrera (escalafón) y
  // especialidad con el concurso. validadoIdSialRol guarda ese rol.
  validado              Boolean          @default(false)
  validadoAt            DateTime?        @map("validado_at") @db.Timestamptz
  validadoIdSialRol     String?          @map("validado_id_sial_rol") @db.VarChar(50)
  cambioEspecialidad          Boolean  @default(false) @map("cambio_especialidad")
  motivoCambioEspecialidad     String?  @map("motivo_cambio_especialidad") @db.Text
  qInscriptos           Int?             @map("q_inscriptos")
  pendienteAutorizacion        Boolean          @default(false) @map("pendiente_autorizacion")
  aprobadoDirector             Boolean          @default(false) @map("aprobado_director")
  siglaSolicitada              String?          @map("sigla_solicitada") @db.VarChar(20)
  codigoRegistroSolicitadoId   String?          @map("codigo_registro_solicitado_id") @db.Uuid
  codigoRegistroSolicitado     CodigoRegistro?  @relation("CphCodigoRegistroSolicitado", fields: [codigoRegistroSolicitadoId], references: [id])
  observaciones         String?          @db.Text
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  concurso         Concurso  @relation(fields: [concursoId], references: [id])
  cargo            Cargo     @relation(fields: [cargoId], references: [id])
  hospital         Hospital  @relation(fields: [hospitalId], references: [id])
  personaDesignada Persona?  @relation("PersonaDesignadaCph", fields: [personaDesignadaId], references: [id])
  inscriptoReservado InscriptoConcurso? @relation("InscriptoReservadoCph", fields: [inscriptoReservadoId], references: [id], onDelete: SetNull)
  etiquetas        EtiquetaConcursoCph[]
  ordenesMerito    OrdenMerito[]
  postulantes      PostulanteConcurso[]
  integrantesDesignados OrdenMeritoIntegrante[] @relation("IntegranteDesignadoEn")
  desiertoHistorial     ConcursoCphDesierto[]
  sorteosJurado         SorteoJurado[]
  inscriptos            InscriptoConcurso[] @relation("InscriptosDeConcurso")

  @@index([hospitalId])
  @@index([estado])
  @@index([subEstado])
  // Partial unique index (no soportado por Prisma @@unique) — definido en
  // prisma/migrations/concurso_cph_unique_abierto/migration.sql:
  // CREATE UNIQUE INDEX ... WHERE estado NOT IN ('finalizado','suspendido')
  // Garantiza que no haya dos concursos CPH abiertos para el mismo cargo
  // incluso ante requests concurrentes (race condition en createConcursoService).
  @@map("concursos_cph")
}

// Historial de rondas desiertas de un concurso CPH (PS16D).
// Un concurso puede tener N rondas desiertas antes de finalizar.
// El estado del concurso en esos casos es 'suspendido' + subEstado 'Q-DESIERTO'.
model ConcursoCphDesierto {
  id                   String    @id @default(uuid()) @db.Uuid
  concursoCphId        String    @map("concurso_cph_id") @db.Uuid
  nroRonda             Int       @map("nro_ronda")
  dispoDesierta        String    @map("dispo_desierta") @db.VarChar(50)
  fechaDispoDesierta   DateTime  @map("fecha_dispo_desierta") @db.Date
  sorteoJurado         DateTime? @map("sorteo_jurado") @db.Date
  disposicion          String?   @db.VarChar(100)
  fechaInscDesde       DateTime? @map("fecha_insc_desde") @db.Date
  fechaInscHasta       DateTime? @map("fecha_insc_hasta") @db.Date
  fechaExamen          DateTime? @map("fecha_examen") @db.Date
  fechaOrdenMerito     DateTime? @map("fecha_orden_merito") @db.Date
  qInscriptos          Int?      @map("q_inscriptos")
  eeDesignacion        String?   @map("ee_designacion") @db.VarChar(150)
  cargaDocumentacion   Boolean?  @map("carga_documentacion")
  fechaAptoMedico      DateTime? @map("fecha_apto_medico") @db.Date
  fechaIte             DateTime? @map("fecha_ite") @db.Date
  proyectoResolucion   Boolean?  @map("proyecto_resolucion")
  resoALaFirma         Boolean?  @map("reso_a_la_firma")
  resolucionDesignacion String?  @map("resolucion_designacion") @db.VarChar(100)
  fechaResolucion      DateTime? @map("fecha_resolucion") @db.Date
  cargoSial            String?   @map("cargo_sial") @db.VarChar(50)
  observaciones        String?   @db.Text
  registradoPorId      String?   @map("registrado_por_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  concursoCph  ConcursoCph @relation(fields: [concursoCphId], references: [id])
  registradoPor Usuario?   @relation("DesiertoRegistradoPor", fields: [registradoPorId], references: [id])

  @@index([concursoCphId])
  @@map("concursos_cph_desiertos")
}

// Acta de sorteo de jurado de un concurso CPH (Etapa 2 — Autorización).
// El jurado se compone de titulares y suplentes sorteados entre profesionales
// del sistema con cargo activo, misma profesión (escalafón) que el cargo a
// concursar y condición de idoneidad (cargo de conducción o antigüedad >= 15
// años). Ver diagrama de formación de jurado (Ley/reglamento CPH). Un concurso
// puede tener N sorteos (relanzamientos / ronda desierta) — el vigente es el
// último por fechaSorteo/createdAt.
model SorteoJurado {
  id                 String    @id @default(uuid()) @db.Uuid
  concursoCphId      String    @map("concurso_cph_id") @db.Uuid
  fechaSorteo        DateTime  @map("fecha_sorteo") @db.Date
  // Semilla usada por el RNG para poder reproducir/auditar el sorteo.
  semilla            String    @db.VarChar(64)
  // Criterios usados (cantidad titulares/suplentes, antigüedad mínima, si
  // exige misma especialidad, etc.) — snapshot para el acta.
  criterios          Json      @db.JsonB
  // Ámbito efectivo alcanzado por el sorteo: 'hospital' si se completó solo
  // con la misma unidad organizativa, 'sistema' si hubo que ampliar al sistema
  // de salud completo, 'mixto' si el jurado combina ambos.
  ambito             String    @db.VarChar(20)
  // Anotaciones/advertencias del sorteo (ej. "no se completó el suplente 3").
  observaciones      String?   @db.Text
  // Confirmación: mientras confirmado=false es un borrador editable (se puede
  // re-sortear o cancelar). Al confirmarse queda de solo lectura (acta final).
  confirmado         Boolean   @default(false)
  confirmadoAt       DateTime? @map("confirmado_at") @db.Timestamptz
  confirmadoPorId    String?   @map("confirmado_por_id") @db.Uuid
  generadoPorId      String?   @map("generado_por_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  concursoCph   ConcursoCph              @relation(fields: [concursoCphId], references: [id])
  generadoPor   Usuario?                 @relation("SorteoJuradoGeneradoPor", fields: [generadoPorId], references: [id])
  confirmadoPor Usuario?                 @relation("SorteoJuradoConfirmadoPor", fields: [confirmadoPorId], references: [id])
  miembros      MiembroJuradoSorteado[]

  @@index([concursoCphId])
  @@map("sorteos_jurado")
}

// Un integrante del jurado sorteado. Se guarda snapshot de por qué fue
// elegible (para el acta) además del vínculo a la persona.
model MiembroJuradoSorteado {
  id             String  @id @default(uuid()) @db.Uuid
  sorteoJuradoId String  @map("sorteo_jurado_id") @db.Uuid
  personaId      String  @map("persona_id") @db.Uuid
  // 'titular' | 'suplente'
  rol            String  @db.VarChar(10)
  // Orden dentro del rol: 1, 2, 3...
  orden          Int
  // Snapshot de datos de la persona/cargo al momento del sorteo (el padrón
  // cambia semanalmente; el acta debe reflejar el estado del día del sorteo).
  apellidoNombre String  @map("apellido_nombre") @db.VarChar(200)
  cuil           String  @db.VarChar(11)
  hospitalId     String? @map("hospital_id") @db.Uuid
  hospitalNombre String? @map("hospital_nombre") @db.VarChar(200)
  puesto         String? @db.VarChar(200)
  especialidad   String? @db.VarChar(200)
  // 'hospital' (misma unidad organizativa que el concurso) | 'sistema'
  ambito         String  @db.VarChar(20)
  // Regla de elegibilidad por la que entró (1, 2 o 3 — ver sorteoJurado.service.ts).
  reglaAplicada  Int?    @map("regla_aplicada")
  // Criterios cumplidos por este miembro (para el detalle del resultado).
  cumpleEspecialidad Boolean @default(false) @map("cumple_especialidad")
  esConduccion       Boolean @default(false) @map("es_conduccion")
  antiguedadAnios    Int?    @map("antiguedad_anios")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  sorteoJurado SorteoJurado @relation(fields: [sorteoJuradoId], references: [id], onDelete: Cascade)
  persona      Persona      @relation("MiembroJuradoPersona", fields: [personaId], references: [id])

  @@index([sorteoJuradoId])
  @@map("miembros_jurado_sorteados")
}

// Inscripto a un concurso CPH (Etapa 3 — Inscripción / Examen / OM). Se cargan
// manualmente (uno por uno) o por importación de Excel/CSV. La "cantidad de
// inscriptos" del concurso se autocalcula contando estas filas. Por ahora se
// guardan solo los datos principales de la persona; el modelo está pensado
// para ampliarse (domicilios, apoderado, cargo actual, etc.).
model InscriptoConcurso {
  id             String   @id @default(uuid()) @db.Uuid
  concursoCphId  String   @map("concurso_cph_id") @db.Uuid

  // Datos personales
  apellido       String   @db.VarChar(120)
  nombre         String   @db.VarChar(120)
  dni            String?  @db.VarChar(20)
  cuil           String?  @db.VarChar(20)
  sexo           String?  @db.VarChar(4)   // M / F / NB / X
  fechaNacimiento DateTime? @map("fecha_nacimiento") @db.Date
  nacionalidad   String?  @db.VarChar(80)

  // Contacto
  telefono       String?  @db.VarChar(40)
  email          String?  @db.VarChar(200)

  // Estudios
  titulo         String?  @db.VarChar(200)
  matricula      String?  @db.VarChar(80)
  especialidad   String?  @db.VarChar(200)

  // Etapa 3 — Examen: si el inscripto se presentó al examen. La cantidad de
  // presentados se cuenta sobre este flag (base del orden de mérito).
  presentoExamen Boolean  @default(false) @map("presento_examen")
  // Nota del examen (0-10). Fuente del orden de mérito: se recalcula solo
  // cada vez que cambia una nota (nota más alta = posición 1; empates se
  // desempatan por apellido/nombre alfabético, ver inscriptos.service.ts).
  // Float (no Decimal) a propósito: Decimal de Prisma serializa a JSON como
  // string, no como number, y complica el frontend sin necesidad real de
  // precisión exacta para una nota de examen.
  nota           Float?   @map("nota")
  // Posición en el orden de mérito (1 = primero). Solo aplica a los que se
  // presentaron al examen. Null = sin posición asignada. Calculada a partir
  // de `nota`, no editable a mano.
  ordenMerito    Int?     @map("orden_merito")

  observaciones  String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  concursoCph    ConcursoCph @relation("InscriptosDeConcurso", fields: [concursoCphId], references: [id], onDelete: Cascade)
  // Concursos en los que este inscripto quedó reservado para el INSAL (Etapa 4).
  reservadoEnCph ConcursoCph[] @relation("InscriptoReservadoCph")

  @@index([concursoCphId])
  @@map("inscriptos_concurso")
}

model ConcursoCeetps {
  id                    String              @id @default(uuid()) @db.Uuid
  concursoId            String              @unique @map("concurso_id") @db.Uuid
  cargoId               String              @map("cargo_id") @db.Uuid
  hospitalId            String              @map("hospital_id") @db.Uuid
  escalafonId           String              @map("escalafon_id") @db.Uuid
  estado                EstadoConcursoCeetps @default(sin_autorizar)
  expedienteConcurso    String?             @map("expediente_concurso") @db.VarChar(150)
  puestoSolicitado      String?             @map("puesto_solicitado") @db.VarChar(200)
  dispoLlamado          String?             @map("dispo_llamado") @db.VarChar(500)
  // Carga horaria en hs (Enfermería/Técnicos) — máx. 2 dígitos, igual al mask
  // del legacy (SeguimientoCeetpsDetail.jsx).
  cargaHoraria          Int?                @map("carga_horaria") @db.SmallInt
  // Apertura 2x18hs — excepción exclusiva de Enfermería (codigoRegistro 87):
  // un cargo de 35hs se abre en dos de 18hs. Ver FORMULARIOS X CASO (legacy).
  apertura2x18          Boolean             @default(false) @map("apertura_2x18")
  informeApertura       String?             @map("informe_apertura") @db.VarChar(150)
  expedienteConcurso2   String?             @map("expediente_concurso_2") @db.VarChar(150)
  fechaIfacs            DateTime?           @map("fecha_ifacs") @db.Date
  fechaInsal            DateTime?           @map("fecha_insal") @db.Date
  expedienteDesignacion String?             @map("expediente_designacion") @db.VarChar(150)
  dispoDesignacion      String?             @map("dispo_designacion") @db.VarChar(500)
  resolucionDesignacion String?             @map("resolucion_designacion") @db.VarChar(500)
  personaDesignadaId    String?             @map("persona_designada_id") @db.Uuid
  observaciones         String?             @db.Text
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  concurso         Concurso  @relation(fields: [concursoId], references: [id])
  cargo            Cargo     @relation(fields: [cargoId], references: [id])
  hospital         Hospital  @relation(fields: [hospitalId], references: [id])
  escalafon        Escalafon @relation(fields: [escalafonId], references: [id])
  personaDesignada Persona?  @relation("PersonaDesignadaCeetps", fields: [personaDesignadaId], references: [id])

  @@index([hospitalId])
  @@index([escalafonId])
  @@index([estado])
  @@map("concursos_ceetps")
}

// =============================================================================
// BAJAS (S5-4)
// =============================================================================

enum EstadoBaja {
  resolucion_a_la_firma
  pendiente
  confirmada
  anulada
}

enum TipoAutorizacion {
  concurso_cph
  alta_cargo
  baja_cargo
}

enum EstadoAutorizacion {
  pendiente
  aprobada
  rechazada
}

enum SolicitudAltaEstado {
  pendiente
  aprobada
  rechazada
}

model Baja {
  id               String     @id @default(uuid()) @db.Uuid
  cargoId          String     @map("cargo_id") @db.Uuid
  hospitalId       String     @map("hospital_id") @db.Uuid
  personaId        String?    @map("persona_id") @db.Uuid
  // Fecha en que se produce la vacante
  fechaBaja        DateTime   @map("fecha_baja") @db.Date
  // Tipo de baja: campo libre (97% vacío en datos reales — ver análisis CSV
  // en PLAN_SCRUM_2026.md POST-SPRINT 4 (4)). Lista sugerida en el frontend
  // pero no obligatoria: Cargo retenido, Interino, Jubilación, etc.
  tipoBaja         String?    @map("tipo_baja") @db.VarChar(100)
  motivo           String?    @db.VarChar(500)
  // Tipificador de origen (ej. "Bajas 2025", "Ampliación 2026", "Art. 48")
  // — campo libre importante para trazabilidad, ver análisis CSV.
  tipificadorOrigen String?   @map("tipificador_origen") @db.VarChar(200)
  // Si genera concurso, se crea automáticamente en S5-5
  eeBaja                String?  @map("ee_baja") @db.VarChar(500)
  partidaPresupuestaria String?  @map("partida_presupuestaria") @db.VarChar(100)
  docRespaldatoria      String?  @map("doc_respaldatoria") @db.VarChar(500)
  fechaPaseParalelo     DateTime? @map("fecha_pase_paralelo") @db.Date
  cargaHoraria          Int?      @map("carga_horaria")
  generaConcurso        Boolean  @default(true) @map("genera_concurso")
  estado           EstadoBaja @default(pendiente)
  observaciones    String?    @db.Text
  registradoPorId  String?    @map("registrado_por") @db.Uuid
  // S17: vinculación al archivo semanal del padrón
  padronVinculadoAt   DateTime? @map("padron_vinculado_at") @db.Timestamptz
  snapshotVinculadoId String?   @map("snapshot_vinculado_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  cargo           Cargo     @relation(fields: [cargoId], references: [id])
  hospital        Hospital  @relation(fields: [hospitalId], references: [id])
  persona         Persona?  @relation(fields: [personaId], references: [id])
  registradoPor   Usuario?  @relation(fields: [registradoPorId], references: [id])
  snapshotVinculado PadronSnapshot? @relation("BajaSnapshotVinculado", fields: [snapshotVinculadoId], references: [id])
  // baja_id nullable en ConcursoCph: hay concursos por ampliación sin baja
  // previa (22% de los datos reales — ver análisis CSV)
  concursos       Concurso[]
  etiquetas       EtiquetaBaja[]
  // S16-8: solicitudes de alta que cubren la vacante dejada por esta baja
  solicitudesAltaOrigen SolicitudAlta[]

  @@index([cargoId])
  @@index([hospitalId])
  @@index([estado])
  @@map("bajas")
}

// =============================================================================
// AUTORIZACIONES (S13)
// =============================================================================

// Autorización genérica: cualquier acción del sistema que requiere aprobación
// de un superior. El campo resolverPorRolSlug usa el slug del rol (string)
// igual que Notificacion.rolSlug — sin FK a roles para evitar query extra
// y acoplamiento. referenciaId apunta al id del objeto origen (ConcursoCph
// o SolicitudAlta). Para CPH con cambio estructural se crean dos en cadena:
// primero director, cuando aprueba se crea la de sgrasv.
model Autorizacion {
  id                 String             @id @default(uuid()) @db.Uuid
  tipo               TipoAutorizacion
  referenciaId       String             @map("referencia_id") @db.Uuid
  referenciaTipo     String             @map("referencia_tipo") @db.VarChar(50)
  estado             EstadoAutorizacion @default(pendiente)
  resolverPorRolSlug String             @map("resolver_por_rol_slug") @db.VarChar(40)
  solicitadoPorId    String?            @map("solicitado_por_id") @db.Uuid
  resueltoPorId      String?            @map("resuelto_por_id") @db.Uuid
  observaciones      String?            @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  solicitadoPor Usuario? @relation("AutorizacionSolicitadaPor", fields: [solicitadoPorId], references: [id])
  resueltoPor   Usuario? @relation("AutorizacionResueltaPor", fields: [resueltoPorId], references: [id])

  @@index([referenciaId])
  @@index([resolverPorRolSlug, estado])
  @@map("autorizaciones")
}

// Solicitud de alta de cargo — no es un Cargo hasta ser aprobada por el director.
// Al aprobar: se generan los Cargo reales con código asignado.
// Al rechazar: persiste para trazabilidad con estado rechazada.
model SolicitudAlta {
  id               String             @id @default(uuid()) @db.Uuid
  hospitalId       String             @map("hospital_id") @db.Uuid
  escalafonId      String             @map("escalafon_id") @db.Uuid
  codigoRegistroId String?            @map("codigo_registro_id") @db.Uuid
  literalPuesto    String             @map("literal_puesto") @db.VarChar(200)
  especialidad     String?            @db.VarChar(200)
  agrupador        String?            @db.VarChar(150)
  unificadorPuesto String?            @map("unificador_puesto") @db.VarChar(200)
  regimen          String?            @db.VarChar(50)
  expediente       String?            @db.VarChar(150)
  desde            DateTime?          @db.Date
  cantidad         Int                @default(1)
  // etiqueta campo libre eliminado — reemplazado por EtiquetaSolicitudAlta (N:M)
  estado           SolicitudAltaEstado @default(pendiente)
  // S16-8: vincula la solicitud con la baja que originó la vacante que viene a cubrir
  bajaOrigenId     String?            @map("baja_origen_id") @db.Uuid
  esTransferencia  Boolean            @default(false) @map("es_transferencia")
  solicitadoPorId  String?            @map("solicitado_por_id") @db.Uuid
  // IDs de los Cargo creados al aprobar (uno por cada unidad de cantidad)
  cargosCreadosIds String[]           @map("cargos_creados_ids") @db.Uuid
  observaciones    String?            @db.Text
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  hospital        Hospital        @relation(fields: [hospitalId], references: [id])
  escalafon       Escalafon       @relation(fields: [escalafonId], references: [id])
  codigoRegistro  CodigoRegistro? @relation(fields: [codigoRegistroId], references: [id])
  bajaOrigen      Baja?           @relation(fields: [bajaOrigenId], references: [id])
  solicitadoPor   Usuario?        @relation("SolicitudAltaSolicitadaPor", fields: [solicitadoPorId], references: [id])
  etiquetas       EtiquetaSolicitudAlta[]

  @@index([hospitalId])
  @@index([estado])
  @@map("solicitudes_alta")
}

// Jerarquía de roles — cimientos para asignación de tareas y permisos en
// cascada (Sprint 14+). En Sprint 13 solo se crea la tabla y el seed.
// Un rol puede tener múltiples padres y múltiples hijos.
model RoleJerarquia {
  rolHijoSlug  String @map("rol_hijo_slug") @db.VarChar(40)
  rolPadreSlug String @map("rol_padre_slug") @db.VarChar(40)

  @@id([rolHijoSlug, rolPadreSlug])
  @@map("role_jerarquias")
}

// =============================================================================
// SEGURIDAD Y AUDITORIA
// =============================================================================

model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(64)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  roleId       String   @map("role_id") @db.Uuid
  hospitalId   String?  @map("hospital_id") @db.Uuid
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  role                  Role             @relation(fields: [roleId], references: [id])
  hospital              Hospital?        @relation(fields: [hospitalId], references: [id])
  refreshTokens         RefreshToken[]
  snapshotsProcesados   PadronSnapshot[] @relation("SnapshotProcesadoPor")
  snapshotsAprobados    PadronSnapshot[] @relation("SnapshotAprobadoPor")
  concursosRegistrados  Concurso[]
  auditLogs             AuditLog[]
  bajasRegistradas          Baja[]
  cargosCreados             Cargo[]          @relation("CargosCreados")
  autorizacionesSolicitadas Autorizacion[]   @relation("AutorizacionSolicitadaPor")
  autorizacionesResueltas   Autorizacion[]   @relation("AutorizacionResueltaPor")
  solicitudesAlta           SolicitudAlta[]  @relation("SolicitudAltaSolicitadaPor")
  desiertosCph              ConcursoCphDesierto[] @relation("DesiertoRegistradoPor")
  sorteosJuradoGenerados    SorteoJurado[]        @relation("SorteoJuradoGeneradoPor")
  sorteosJuradoConfirmados  SorteoJurado[]        @relation("SorteoJuradoConfirmadoPor")
  organigramaUploads        OrganigramaUpload[]   @relation("OrganigramaUploadSubidoPor")

  @@map("usuarios")
}

// ── RBAC dinámico ────────────────────────────────────────────────────────────
// Roles fijos + matriz estática en código reemplazados por roles/permisos en BD,
// editables por el admin desde /configuracion/permisos. `admin` (esSistema=true,
// slug="admin") queda protegido en el service layer: no editable, no borrable,
// siempre con acceso total (bypass explícito en requirePermiso).

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(40)
  nombre      String   @db.VarChar(100)
  descripcion String?  @db.VarChar(255)
  esSistema   Boolean  @default(false) @map("es_sistema")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  usuarios Usuario[]
  permisos RolePermiso[]

  @@map("roles")
}

model Permiso {
  id          String  @id @default(uuid()) @db.Uuid
  modulo      String  @db.VarChar(40)
  accion      String  @db.VarChar(40)
  descripcion String? @db.VarChar(255)

  roles RolePermiso[]

  @@unique([modulo, accion])
  @@map("permisos")
}

model RolePermiso {
  roleId    String @map("role_id") @db.Uuid
  permisoId String @map("permiso_id") @db.Uuid

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([roleId, permisoId])
  @@map("role_permisos")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  familyId  String    @map("family_id") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revocado  Boolean   @default(false)
  ip        String?   @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  accion     String   @db.VarChar(32)
  entidad    String   @db.VarChar(64)
  entidadId  String?  @map("entidad_id") @db.VarChar(64)
  // Método HTTP + ruta completa de la request (ej. "POST", "/api/v1/padron/
  // snapshots/xxx/rechazar") — red de seguridad para cuando `accion` no
  // alcanza a describir qué pasó exactamente (ver auditoria.service.ts).
  // Nullable: los registros previos a esta columna no lo tienen.
  metodo     String?  @db.VarChar(10)
  ruta       String?  @db.VarChar(300)
  cambios    Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([entidad])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// ETIQUETAS — catálogo global de agrupación (cargos, concursos, bajas)
// Una etiqueta es un nombre de grupo libre asignable a cualquier entidad.
// El permiso de crear/asignar lo controla el módulo donde se opera.
// =============================================================================

model Etiqueta {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String   @unique @db.VarChar(100)
  color     String?  @db.VarChar(20)   // hex o nombre CSS, ej. "#e11d48"
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  cargos      EtiquetaCargo[]
  concursos   EtiquetaConcursoCph[]
  bajas       EtiquetaBaja[]
  altas       EtiquetaSolicitudAlta[]

  @@map("etiquetas")
}

model EtiquetaCargo {
  etiquetaId String @map("etiqueta_id") @db.Uuid
  cargoId    String @map("cargo_id") @db.Uuid

  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)
  cargo    Cargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)

  @@id([etiquetaId, cargoId])
  @@map("etiquetas_cargo")
}

model EtiquetaConcursoCph {
  etiquetaId    String @map("etiqueta_id") @db.Uuid
  concursoCphId String @map("concurso_cph_id") @db.Uuid

  etiqueta    Etiqueta    @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)
  concursoCph ConcursoCph @relation(fields: [concursoCphId], references: [id], onDelete: Cascade)

  @@id([etiquetaId, concursoCphId])
  @@map("etiquetas_concurso_cph")
}

model EtiquetaBaja {
  etiquetaId String @map("etiqueta_id") @db.Uuid
  bajaId     String @map("baja_id") @db.Uuid

  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)
  baja     Baja     @relation(fields: [bajaId], references: [id], onDelete: Cascade)

  @@id([etiquetaId, bajaId])
  @@map("etiquetas_baja")
}

model EtiquetaSolicitudAlta {
  etiquetaId       String @map("etiqueta_id") @db.Uuid
  solicitudAltaId  String @map("solicitud_alta_id") @db.Uuid

  etiqueta      Etiqueta      @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)
  solicitudAlta SolicitudAlta @relation(fields: [solicitudAltaId], references: [id], onDelete: Cascade)

  @@id([etiquetaId, solicitudAltaId])
  @@map("etiquetas_solicitud_alta")
}

// =============================================================================
// ORDEN DE MÉRITO — documento reutilizable entre concursos
// Vigencia: 6 meses desde fechaPublicacion + prorroga opcional de 60 días.
// Un concurso de la misma especialidad debe alertar si hay una OM vigente.
// =============================================================================

enum EstadoOrdenMerito {
  vigente
  prorrogada
  vencida
}

model OrdenMerito {
  id              String             @id @default(uuid()) @db.Uuid
  concursoCphId   String             @map("concurso_cph_id") @db.Uuid
  especialidad    String             @db.VarChar(200)
  puesto          String?            @db.VarChar(200)
  expediente      String?            @db.VarChar(200)  // IF del orden de mérito
  fechaPublicacion DateTime          @map("fecha_publicacion") @db.Date
  // fechaVencimiento = fechaPublicacion + 6 meses (calculado al crear, no editable)
  fechaVencimiento DateTime          @map("fecha_vencimiento") @db.Date
  // prorroga: +60 días adicionales desde fechaVencimiento (nullable = sin prórroga)
  fechaProrroga   DateTime?          @map("fecha_prorroga") @db.Date
  estado          EstadoOrdenMerito  @default(vigente)
  observaciones   String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  concursoCph  ConcursoCph            @relation(fields: [concursoCphId], references: [id])
  integrantes  OrdenMeritoIntegrante[]

  @@index([especialidad, estado])
  @@map("ordenes_merito")
}

model OrdenMeritoIntegrante {
  id              String    @id @default(uuid()) @db.Uuid
  ordenMeritoId   String    @map("orden_merito_id") @db.Uuid
  // personaId nullable: el candidato puede no estar en el padrón
  personaId       String?   @map("persona_id") @db.Uuid
  cuil            String    @db.VarChar(11)
  apellidoNombre  String    @map("apellido_nombre") @db.VarChar(200)
  especialidad    String?   @db.VarChar(200)
  posicion        Int       // lugar en el orden de mérito (1 = primero)
  designado       Boolean   @default(false)
  // concursoCphDesignadoId: qué concurso lo designó (para reutilización)
  concursoCphDesignadoId String? @map("concurso_cph_designado_id") @db.Uuid
  // anulado: integrante que ya no está disponible (renunció, no se presentó,
  // etc.) sin haber sido designado. No cuenta como disponible para reutilizar.
  anulado         Boolean   @default(false)
  motivoAnulado   String?   @map("motivo_anulado") @db.VarChar(300)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  ordenMerito          OrdenMerito  @relation(fields: [ordenMeritoId], references: [id], onDelete: Cascade)
  persona              Persona?     @relation(fields: [personaId], references: [id])
  concursoCphDesignado ConcursoCph? @relation("IntegranteDesignadoEn", fields: [concursoCphDesignadoId], references: [id])

  @@unique([ordenMeritoId, posicion])
  @@unique([ordenMeritoId, cuil])
  @@index([cuil])
  @@map("orden_merito_integrantes")
}

// =============================================================================
// POSTULANTES — personas que se postulan a concursos CPH
// Pueden o no estar en el padrón (personaId nullable).
// Al cargar un CUIL que ya existe en Persona se vincula automáticamente.
// =============================================================================

enum EstadoPostulacion {
  inscripto
  admitido
  rechazado
}

model Postulante {
  id             String    @id @default(uuid()) @db.Uuid
  // personaId nullable: postulante externo que no está en el padrón
  personaId      String?   @unique @map("persona_id") @db.Uuid
  cuil           String    @unique @db.VarChar(11)
  apellidoNombre String    @map("apellido_nombre") @db.VarChar(200)
  especialidad   String?   @db.VarChar(200)
  // fuente: si vino del padrón o es externo (se postuló sin estar en planta)
  esExterno      Boolean   @default(false) @map("es_externo")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  persona       Persona?              @relation(fields: [personaId], references: [id])
  postulaciones PostulanteConcurso[]

  @@map("postulantes")
}

model PostulanteConcurso {
  id              String             @id @default(uuid()) @db.Uuid
  postulanteId    String             @map("postulante_id") @db.Uuid
  concursoCphId   String             @map("concurso_cph_id") @db.Uuid
  fechaPostulacion DateTime          @map("fecha_postulacion") @db.Date
  estado          EstadoPostulacion  @default(inscripto)
  observaciones   String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz

  postulante  Postulante  @relation(fields: [postulanteId], references: [id])
  concursoCph ConcursoCph @relation(fields: [concursoCphId], references: [id])

  // Un postulante no puede inscribirse dos veces al mismo concurso
  @@unique([postulanteId, concursoCphId])
  @@index([concursoCphId])
  @@map("postulantes_concurso")
}

// =============================================================================
// CATALOGOS (S2-14 / S2-15)
// =============================================================================


enum ModalidadPuesto {
  pof
  pou
  ambos
}

enum TipoPuesto {
  ejecucion
  conduccion
}

model PuestoCargo {
  id          String          @id @default(uuid()) @db.Uuid
  escalafonId String          @map("escalafon_id") @db.Uuid
  modalidad   ModalidadPuesto
  nombre      String          @db.VarChar(200)
  activo      Boolean         @default(true)
  tipoPuesto  TipoPuesto      @default(ejecucion) @map("tipo_puesto")

  escalafon      Escalafon            @relation(fields: [escalafonId], references: [id])
  especialidades EspecialidadPuesto[]

  @@unique([escalafonId, modalidad, nombre])
  @@index([escalafonId, modalidad])
  @@map("puestos_cargo")
}


model EspecialidadPuesto {
  id           String     @id @default(uuid()) @db.Uuid
  puestoCargId String     @map("puesto_cargo_id") @db.Uuid
  nombre       String     @db.VarChar(200)
  activo       Boolean    @default(true)

  puesto PuestoCargo @relation(fields: [puestoCargId], references: [id], onDelete: Cascade)

  @@unique([puestoCargId, nombre])
  @@index([puestoCargId])
  @@map("especialidades_puesto")
}

// =============================================================================
// TABLAS DE REFERENCIA (Mapeos Dotaneitor)
// =============================================================================

model RefAgrupador {
  id         String  @id @default(uuid()) @db.Uuid
  cruce      String  @unique @db.VarChar(300)
  escalafon  String  @db.VarChar(150)
  litPuesto  String  @map("lit_puesto") @db.VarChar(200)
  agrupador  String  @db.VarChar(150)
  activo     Boolean @default(true)

  @@map("ref_agrupadores")
}

model RefUnificadorPuesto {
  id         String  @id @default(uuid()) @db.Uuid
  cruce      String  @unique @db.VarChar(400)
  litCodReg  String  @map("lit_cod_reg") @db.VarChar(150)
  litPuesto  String  @map("lit_puesto") @db.VarChar(200)
  unificador String  @db.VarChar(200)
  activo     Boolean @default(true)

  @@map("ref_unificadores_puesto")
}

model RefEspecialidadCuil {
  id           String  @id @default(uuid()) @db.Uuid
  tipo         String  @db.VarChar(20) // cph, suplentes, residentes
  cuil         String  @db.VarChar(11)
  cuilYRol     String? @map("cuil_y_rol") @db.VarChar(50)
  especialidad String  @db.VarChar(200)
  activo       Boolean @default(true)

  @@index([tipo, cuil])
  @@map("ref_especialidades_cuil")
}

// S2-13: datos hardcodeados de Dotaneitor → tablas

model RefAbreviaturaTecnica {
  id       String  @id @default(uuid()) @db.Uuid
  sigla    String  @unique @db.VarChar(50)
  activo   Boolean @default(true)

  @@map("ref_abreviaturas_tecnicas")
}

model RefAbreviaturaTitulo {
  id       String  @id @default(uuid()) @db.Uuid
  titulo   String  @unique @db.VarChar(50)
  activo   Boolean @default(true)

  @@map("ref_abreviaturas_titulo")
}

model RefCorreccionLitPuesto {
  id          String  @id @default(uuid()) @db.Uuid
  codReg      String? @map("cod_reg") @db.VarChar(10) // null = aplica a todos los cod_reg
  original    String  @db.VarChar(200)
  correccion  String  @db.VarChar(200)
  activo      Boolean @default(true)

  @@unique([codReg, original])
  @@map("ref_correcciones_lit_puesto")
}

model RefCorreccionEspecialidad {
  id         String  @id @default(uuid()) @db.Uuid
  original   String  @unique @db.VarChar(200)
  correccion String  @db.VarChar(200)
  activo     Boolean @default(true)

  @@map("ref_correcciones_especialidad")
}

model RefEspecialidadPorPuesto {
  id           String  @id @default(uuid()) @db.Uuid
  agrupador    String  @unique @db.VarChar(150)
  especialidad String  @db.VarChar(200)
  purezaPct    Int?    @map("pureza_pct") // % de pureza empírica documentado
  activo       Boolean @default(true)

  @@map("ref_especialidad_por_puesto")
}

model RefConectorMinuscula {
  id       String  @id @default(uuid()) @db.Uuid
  conector String  @unique @db.VarChar(30)
  activo   Boolean @default(true)

  @@map("ref_conectores_minuscula")
}

model RefSufijoOrdinal {
  id     String  @id @default(uuid()) @db.Uuid
  sufijo String  @unique @db.VarChar(10)
  activo Boolean @default(true)

  @@map("ref_sufijos_ordinales")
}

// =============================================================================
// NOTIFICACIONES (S10-1)
// =============================================================================

enum TipoNotificacion {
  concurso_estancado
  concurso_iniciado
  baja_pendiente
  autorizacion_pendiente
  autorizacion_resuelta
  vencimiento_conduccion
}

model Notificacion {
  id          String            @id @default(uuid()) @db.Uuid
  tipo        TipoNotificacion
  // Rol destinatario (slug del rol, ej. "director", "concursales_cph")
  rolSlug     String            @map("rol_slug") @db.VarChar(40)
  titulo      String            @db.VarChar(200)
  mensaje     String            @db.Text
  // Referencia opcional al objeto que originó la notificación
  origenTipo  String?           @map("origen_tipo") @db.VarChar(50)  // "concurso_cph", "baja", etc.
  origenId    String?           @map("origen_id") @db.Uuid
  // Clave de deduplicación: evita crear la misma alerta dos veces
  // (ej. "concurso_estancado:{concursoCphId}:30d")
  origenKey   String?           @unique @map("origen_key") @db.VarChar(200)
  leida       Boolean           @default(false)
  creadaAt    DateTime          @default(now()) @map("creada_at") @db.Timestamptz
  leidaAt     DateTime?         @map("leida_at") @db.Timestamptz

  @@index([rolSlug, leida])
  @@index([tipo])
  @@index([creadaAt])
  @@map("notificaciones")
}

// =============================================================================
// BAJAS SIAL — archivo semanal de bajas del Ministerio de Salud
// =============================================================================

model BajaSialSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  filename        String   @db.VarChar(255)
  fechaArchivo    DateTime @map("fecha_archivo") @db.Date
  totalRegistros  Int      @default(0) @map("total_registros")
  // diferencias respecto al snapshot anterior aprobado
  nuevas          Int      @default(0)   // registros que no estaban antes
  salidas         Int      @default(0)   // registros que ya no están
  modificadas     Int      @default(0)   // registros que cambiaron campos
  estado          EstadoSnapshot @default(procesando)
  errorMsg        String?  @map("error_msg") @db.Text
  procesadoPorId  String?  @map("procesado_por") @db.Uuid
  aprobadoPorId   String?  @map("aprobado_por") @db.Uuid
  aprobadoAt      DateTime? @map("aprobado_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  diffs           BajaSialDiff[]
  registros       BajaSialRegistro[]

  @@map("baja_sial_snapshots")
}

model BajaSialDiff {
  id          String   @id @default(uuid()) @db.Uuid
  snapshotId  String   @map("snapshot_id") @db.Uuid
  tipo        TipoDiff
  cargo       String   @db.VarChar(30)   // id_sial_rol del archivo (CARGO col)
  cuil        String   @db.VarChar(20)
  ayn         String   @db.VarChar(200)
  escalafon   String?  @db.VarChar(100)
  litPuesto   String?  @map("lit_puesto") @db.VarChar(200)
  motBaja     String?  @map("mot_baja") @db.VarChar(200)
  cargoHasta  DateTime? @map("cargo_hasta") @db.Date
  // triangulacion: si el CUIL existe en personas y si tiene ocupacion activa
  existeEnPersonas   Boolean @default(false) @map("existe_en_personas")
  tieneOcupActiva    Boolean @default(false) @map("tiene_ocup_activa")
  // Datos del cargo v2 cuando `tieneOcupActiva` (ver triangular() en
  // bajas-sial.service.ts) — faltaban en el modelo pese a que el INSERT de
  // procesarSnapshot() ya los usaba desde que se escribió el service; sin
  // esto ninguna carga de Bajas Salud podía funcionar (hallazgo 2026-09-14).
  codRegistro String? @map("cod_registro") @db.VarChar(30)
  hospital    String? @db.VarChar(20)
  especialidad String? @db.VarChar(200)
  codReg      String? @map("cod_reg") @db.VarChar(10)
  campo       String?  @db.VarChar(100)  // solo para tipo=modificado
  valorAnterior String? @map("valor_anterior") @db.Text
  valorNuevo  String?  @map("valor_nuevo") @db.Text

  snapshot    BajaSialSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([tipo])
  @@index([cuil])
  @@map("baja_sial_diffs")
}

model BajaSialRegistro {
  id          String   @id @default(uuid()) @db.Uuid
  snapshotId  String   @map("snapshot_id") @db.Uuid
  cargo       String   @db.VarChar(30)
  cuil        String   @db.VarChar(20)
  ayn         String   @db.VarChar(200)
  numDoc      String?  @map("num_doc") @db.VarChar(20)
  sexo        String?  @db.VarChar(1)
  fecNacim    DateTime? @map("fec_nacim") @db.Date
  edad        Int?
  codRep      String?  @map("cod_rep") @db.VarChar(20)
  descRep     String?  @map("desc_rep") @db.VarChar(200)
  escalafon   String?  @db.VarChar(100)
  regimen     String?  @db.VarChar(100)
  sitRev      String?  @map("sit_rev") @db.VarChar(100)
  codReg      String?  @map("cod_reg") @db.VarChar(20)
  litCodReg   String?  @map("lit_cod_reg") @db.VarChar(200)
  puesto      String?  @db.VarChar(20)
  litPuesto   String?  @map("lit_puesto") @db.VarChar(200)
  codAgrup    String?  @map("cod_agrup") @db.VarChar(20)
  litAgrup    String?  @map("lit_agrup") @db.VarChar(200)
  cargoDesde  DateTime? @map("cargo_desde") @db.Date
  cargoHasta  DateTime? @map("cargo_hasta") @db.Date
  docRespAlta String?  @map("doc_resp_alta") @db.VarChar(200)
  docRespBaja String?  @map("doc_resp_baja") @db.VarChar(200)
  motBaja     String?  @map("mot_baja") @db.VarChar(200)
  carCodigo   String?  @map("car_codigo") @db.VarChar(50)
  funcion     String?  @map("funcion") @db.VarChar(100)

  snapshot    BajaSialSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([cuil])
  @@map("baja_sial_registros")
}
