// =============================================================================
// CARGA SEMANAL DE ARCHIVOS
// =============================================================================

model DimCargaSesion {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo         TipoCargaSemanal
  fechaArchivo DateTime?                 @map("fecha_archivo") @db.Date
  estado       EstadoCargaSemanal        @default(procesando)
  errorMsg     String?                   @map("error_msg")
  informe      Json?
  usuarioId    String?                   @map("usuario_id") @db.Uuid
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  finalizadoAt DateTime?                 @map("finalizado_at") @db.Timestamptz(6)
  usuario      Usuario?                  @relation("DimCargaSesionUsuario", fields: [usuarioId], references: [id])
  archivos         DimCargaArchivo[]
  diffs            DimCargaDiff[]
  snapshots        DimCargaPadronSnapshot[]
  kpis             DimCargaKpisPeriodo[]
  pouDecretoCargas DimPouDecretoCarga[]
  incidencias      DimIncidencia[]
  dimConcursos     DimConcurso[]

  @@index([tipo, estado])
  @@index([fechaArchivo])
  @@index([createdAt])
  @@map("dim_carga_sesiones")
}

model DimCargaArchivo {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sesionId  String         @map("sesion_id") @db.Uuid
  filename  String         @db.VarChar(255)
  filas     Int            @default(0)
  sha256    String?        @db.VarChar(64)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  sesion    DimCargaSesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([sesionId])
  @@map("dim_carga_archivos")
}

model DimCargaDiff {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sesionId      String         @map("sesion_id") @db.Uuid
  tablaAfectada String         @map("tabla_afectada") @db.VarChar(50)
  tipoDiff      TipoDiff       @map("tipo_diff")
  /// clave primaria de la fila afectada (id_sial_rol, cuil, cod_rep, etc.)
  clave         String         @db.VarChar(50)
  campo         String?        @db.VarChar(100)
  valorAnterior String?        @map("valor_anterior")
  valorNuevo    String?        @map("valor_nuevo")
  sesion        DimCargaSesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([sesionId])
  @@index([sesionId, tablaAfectada])
  @@index([sesionId, tipoDiff])
  @@index([clave])
  @@map("dim_carga_diffs")
}

/// Foto completa del padrón en cada carga semanal.
/// Permite reconstruir el estado en cualquier fecha y responder:
/// ¿qué cargos tuvo una persona? ¿quién ocupó un cargo? ¿cómo evolucionó un puesto?
model DimCargaPadronSnapshot {
  id               Int            @id @default(autoincrement())
  sesionId         String         @map("sesion_id") @db.Uuid
  fechaCorte       DateTime       @map("fecha_corte") @db.Date
  /// Identificador del rol en SIAL (clave del padrón Hacienda)
  idSialRol        String         @map("id_sial_rol") @db.VarChar(12)
  cuil             String?        @db.VarChar(11)
  apellidoNombre   String?        @map("apellido_nombre") @db.VarChar(200)
  codigoRegistro   String?        @map("codigo_registro") @db.VarChar(10)
  litCodReg        String?        @map("lit_cod_reg") @db.VarChar(150)
  codRep           String?        @map("cod_rep") @db.VarChar(10)
  descRep          String?        @map("desc_rep") @db.VarChar(200)
  literalPuesto    String?        @map("literal_puesto") @db.VarChar(200)
  especialidad     String?        @db.VarChar(200)
  situacionRevista String?        @map("situacion_revista") @db.VarChar(50)
  jcat             String?        @db.VarChar(10)
  cargoDesde       DateTime?      @map("cargo_desde") @db.Date
  cargoHasta       DateTime?      @map("cargo_hasta") @db.Date
  sesion           DimCargaSesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([sesionId])
  @@index([fechaCorte])
  @@index([cuil])
  @@index([idSialRol])
  @@index([codigoRegistro])
  @@index([codRep])
  @@index([fechaCorte, codigoRegistro])
  @@index([cuil, fechaCorte])
  @@map("dim_carga_padron_snapshot")
}

/// Métricas agregadas por período (mes/año), carrera y efector.
/// Permite comparar evolución entre períodos y años.
// =============================================================================
// DIM INCIDENCIAS Y CONCURSOS
// =============================================================================

model DimIncidencia {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo           DimTipoIncidencia
  estado         DimEstadoIncidencia @default(pendiente)
  sesionId       String           @map("sesion_id") @db.Uuid
  idSialRol      String?          @map("id_sial_rol") @db.VarChar(12)
  codigoRegistro String           @map("codigo_registro") @db.VarChar(10)
  efector        String           @db.VarChar(20)
  literalPuesto  String           @map("literal_puesto") @db.VarChar(200)
  especialidad   String?          @db.VarChar(200)
  cuil           String?          @db.VarChar(11)
  codigoCargo    String?          @map("codigo_cargo") @db.VarChar(30)
  concursoId     String?          @unique @map("concurso_id") @db.Uuid
  resolucion     String?          @db.VarChar(500)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  sesion         DimCargaSesion   @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  efectorRel     DimEfectores     @relation(fields: [efector], references: [sigla])
  concurso       DimConcurso?     @relation(fields: [concursoId], references: [id])
  @@index([sesionId])
  @@index([tipo, estado])
  @@index([efector, codigoRegistro])
  @@index([idSialRol])
  @@map("dim_incidencias")
}

model DimConcurso {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo           TipoConcurso
  motivoOrigen   String             @map("motivo_origen") @db.VarChar(30)
  efector        String             @db.VarChar(20)
  codigoRegistro String             @map("codigo_registro") @db.VarChar(10)
  literalPuesto  String             @map("literal_puesto") @db.VarChar(200)
  especialidad   String?            @db.VarChar(200)
  codigoCargo    String?            @map("codigo_cargo") @db.VarChar(30)
  estado         String             @default("no_iniciado") @db.VarChar(20)
  observaciones  String?
  sesionId       String?            @map("sesion_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  efectorRel     DimEfectores       @relation(fields: [efector], references: [sigla])
  sesion         DimCargaSesion?    @relation(fields: [sesionId], references: [id], onDelete: SetNull)
  incidencia     DimIncidencia?
  cph            DimConcursoCph?
  ceetps         DimConcursoCeetps?
  @@index([tipo, estado])
  @@index([efector, codigoRegistro])
  @@index([sesionId])
  @@map("dim_concurso")
}

model DimConcursoCph {
