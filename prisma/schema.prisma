/// Mapeo fijo nombre-en-POU-decreto → sigla en dim_efectores.
/// Se carga una sola vez con seed; no cambia salvo nuevo hospital.
model DimPouDecretoMapeo {
  nombrePou String       @id @map("nombre_pou") @db.VarChar(300)
  sigla     String       @db.VarChar(20)
  efector   DimEfectores @relation(fields: [sigla], references: [sigla])

  @@index([sigla])
  @@map("dim_pou_decreto_mapeo")
}

/// Dotación normativa del decreto (por hospital, perfil y especialidad).
/// Fuente: POU_DECRETO 315-22 y modificaciones - HISTORICO.xlsx
model DimPouDecreto {
  id             Int          @id @default(autoincrement())
  sigla          String       @db.VarChar(20)
  perfil         String       @db.VarChar(100)
  especialidad   String       @db.VarChar(200)
  dotacionDiaria Int?         @map("dotacion_diaria")
  dotacionSem    Int?         @map("dotacion_sem")
  resolucion     String?      @db.VarChar(100)
  vigenteDesde   DateTime?    @map("vigente_desde") @db.Date
  efector        DimEfectores @relation(fields: [sigla], references: [sigla])

  @@unique([sigla, perfil, especialidad])
  @@index([sigla])
  @@map("dim_pou_decreto")
}

/// Registro de cada carga del archivo POU histórico (decreto).
model DimPouDecretoCarga {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sesionId  String         @map("sesion_id") @db.Uuid
  archivo   String         @db.VarChar(500)
  filas     Int
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  sesion    DimCargaSesion @relation(fields: [sesionId], references: [id])

  @@index([createdAt])
  @@map("dim_pou_decreto_cargas")
}

model PouEspecialidadMapeo {
  especialidadPou   String @map("especialidad_pou") @db.VarChar(100)
  especialidadCargo String @map("especialidad_cargo") @db.VarChar(200)

  @@id([especialidadPou, especialidadCargo])
  @@map("pou_especialidad_mapeo")
