  generaCargos    Boolean     @default(true) @map("genera_cargos")
  supervisada     Boolean     @default(false)
  regimenOverride String?     @map("regimen_override") @db.VarChar(100)
  activo          Boolean     @default(true)
  carrera         DimCarreras @relation(fields: [codigoRegistro], references: [codigoRegistro])

  @@index([tipoConcurso])
  @@map("dim_gestionables")
}

model DimCargos {
  codigoCargo       String             @id @map("codigo_cargo") @db.VarChar(30)
  codigoRegistro    String?            @map("codigo_registro") @db.VarChar(10)
  // FKs normalizadas — fuente de verdad para carrera, tipo y especialidad
  tipoCargoid       Int?               @map("tipo_cargo_id")
  especialidadId    Int?               @map("especialidad_id")
  // Campos operativos
  efector           String?            @db.VarChar(20)
  modalidad         String?            @db.VarChar(10)
  estado            String?            @db.VarChar(30)
  subEstado         String?            @map("sub_estado") @db.VarChar(30)
  diaPou            String?            @map("dia_pou") @db.VarChar(20)
  cargoIdSistema    String?            @map("cargo_id_sistema") @db.Uuid
  // Jornada contractual enfermería (CR 87 / 85 con puesto de enfermería)
  jornadaEnfermeria    String?         @map("jornada_enfermeria") @db.VarChar(3)
  // Legacy — reemplazados por FKs. Mantener hasta producción.
  literalPuestoLegacy  String?         @map("literal_puesto") @db.VarChar(150)
  especialidadLegacy   String?         @map("especialidad_cargo")
  // Relaciones
  dimCarrera        DimCarreras?       @relation(fields: [codigoRegistro], references: [codigoRegistro])
  dimEfector        DimEfectores?      @relation(fields: [efector], references: [sigla])
  dimTipoCargo      DimTiposCargos?    @relation(fields: [tipoCargoid], references: [id])
  dimEspecialidad   DimEspecialidades? @relation(fields: [especialidadId], references: [id])

  @@index([cargoIdSistema])
  @@index([codigoRegistro])
  @@index([efector])
  @@index([tipoCargoid])
  @@index([especialidadId])
  @@index([modalidad])
  @@index([subEstado])
  @@map("dim_cargos")
}

model DimTiposCargos {
  id             Int               @id @default(autoincrement())
  codigoRegistro String            @map("codigo_registro") @db.VarChar(10)
  nombre         String            @db.VarChar(200)
  tipoCargo      String            @default("ejecucion") @map("tipo_cargo") @db.VarChar(20)
  activo         Boolean           @default(true)
