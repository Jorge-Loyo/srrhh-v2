generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hospital {
  id                  String            @id @default(uuid()) @db.Uuid
  sigla               String            @unique @db.VarChar(20)
  nombre              String            @db.VarChar(200)
  universoTotalizador String?           @map("universo_totalizador") @db.VarChar(100)
  tipo                String?           @db.VarChar(100)
  monovalencia        String?           @db.VarChar(100)
  activo              Boolean           @default(true)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  nombreResumido      String?           @map("nombre_resumido") @db.VarChar(200)
  comuna              String?           @db.VarChar(50)
  coordenadas         String?           @db.VarChar(60)
  tamanio             String?           @map("tamanio") @db.VarChar(30)
  tipificacionSsah    String?           @map("tipificacion_ssah") @db.VarChar(100)
  areaProgramatica    AreaProgramatica?
  bajas               Baja[]
  cargos              Cargo[]
  concursos           Concurso[]
  concursosCeetps     ConcursoCeetps[]
  concursosCph        ConcursoCph[]
  solicitudesAlta     SolicitudAlta[]
  supervisorSiglas    UsuarioSigla[]    @relation("HospitalSiglas")
  usuarios            Usuario[]

  @@map("hospitales")
}

model DimOrganigrama {
  id                  String  @id @default(uuid()) @db.Uuid
  lvl                 Int
  tipo                String  @db.VarChar(50)
  codigoReparticion   String  @unique @map("codigo_reparticion") @db.VarChar(20)
  universoTotalizador String? @map("universo_totalizador") @db.VarChar(100)
  regimenEmpleo       String? @map("regimen_empleo") @db.VarChar(200)
  descRep             String? @map("desc_rep") @db.VarChar(200)
  sigla               String  @db.VarChar(20)
  padre               String? @db.VarChar(100)
  path                String  @db.VarChar(600)
  pathNombres         String  @map("path_nombres") @db.VarChar(1200)

  @@index([sigla])
  @@index([padre])
  @@index([universoTotalizador])
  @@map("dim_organigrama")
}

model DimOrganigramaUpload {
  id          String   @id @default(uuid()) @db.Uuid
  filename    String   @db.VarChar(255)
  filas       Int
  subidoPorId String?  @map("subido_por_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  subidoPor   Usuario? @relation("DimOrganigramaUploadSubidoPor", fields: [subidoPorId], references: [id])

  @@map("dim_organigrama_uploads")
}

model AreaProgramatica {
  id                String   @id @default(uuid()) @db.Uuid
  nombre            String   @unique @db.VarChar(100)
  hospitalId        String   @unique @map("hospital_id") @db.Uuid
  codigoReparticion String?  @unique @map("codigo_reparticion") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  hospital          Hospital @relation(fields: [hospitalId], references: [id])
  cesacs            Cesac[]

  @@map("areas_programaticas")
}

model Cesac {
  id                 String           @id @default(uuid()) @db.Uuid
  numero             Int              @unique
  nombre             String?          @db.VarChar(150)
  direccion          String?          @db.VarChar(200)
  barrio             String?          @db.VarChar(100)
  nivel              NivelCesac
  areaProgramaticaId String           @map("area_programatica_id") @db.Uuid
  codigoReparticion  String?          @unique @map("codigo_reparticion") @db.VarChar(20)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  cargos             Cargo[]
  areaProgramatica   AreaProgramatica @relation(fields: [areaProgramaticaId], references: [id])

  @@index([areaProgramaticaId])
  @@map("cesacs")
}

model UnidadFijaApayC {
  id                String                  @id @default(uuid()) @db.Uuid
  nombre            String                  @db.VarChar(150)
  tipo              TipoUnidadFija
  nivelOrganico     NivelOrganicoUnidadFija @map("nivel_organico")
  codigoReparticion String?                 @unique @map("codigo_reparticion") @db.VarChar(20)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  cargos            Cargo[]

  @@map("unidades_fijas_apayc")
}

model KpisDotacionSnapshot {
  fecha            DateTime @db.Date
  codigoRegistro   String   @map("codigo_registro") @db.VarChar(20)
  situacionRevista String   @map("situacion_revista") @db.VarChar(50)
  personas         Int

  @@id([fecha, codigoRegistro, situacionRevista])
  @@index([fecha])
  @@map("kpis_dotacion_snapshot")
}

model DimPouOcupacion {
  id               String   @id @default(uuid()) @db.Uuid
  sigla            String   @db.VarChar(10)
  descripcionSigla String?  @map("descripcion_sigla") @db.VarChar(100)
  perfil           String   @db.VarChar(50)
  especialidad     String   @db.VarChar(100)
  dotacionDiaria   Int?     @map("dotacion_diaria")
  dotacionSem      Int?     @map("dotacion_sem")
  dotacionTotal    Int?     @map("dotacion_total")
  activos          Int?
  tecnicos         Int?
  vacantes         Int?
  efector          DimEfectores @relation(fields: [sigla], references: [sigla])
  puestos          DimPouOcupacionPuesto[]

  @@unique([sigla, perfil, especialidad])
  @@index([sigla])
  @@map("dim_pou_ocupacion")
}

/// Mapeo entre una fila de dim_pou_ocupacion y los puestos individuales de dim_puestos.
/// Se puebla al confirmar la carga semanal de POU.
/// Los puestos sin match quedan sin fila aquí (vacantes o perfiles sin cargo activo).
model DimPouOcupacionPuesto {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pouId       String          @map("pou_id") @db.Uuid
  idSialRol   String          @map("id_sial_rol") @db.VarChar(30)
  vinculadoManualmente Boolean @default(false) @map("vinculado_manualmente")
  pou         DimPouOcupacion @relation(fields: [pouId], references: [id])
  puesto      DimPuestos      @relation(fields: [idSialRol], references: [idSialRol])

  @@unique([pouId, idSialRol])
  @@index([idSialRol])
  @@map("dim_pou_ocupacion_puestos")
}

model Escalafon {
  id              String           @id @default(uuid()) @db.Uuid
  codigo          String           @unique @db.VarChar(20)
  nombre          String           @db.VarChar(100)
  activo          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  cargos          Cargo[]
  codigosRegistro CodigoRegistro[]
  concursosCeetps ConcursoCeetps[]
  puestosCargo    PuestoCargo[]
  solicitudesAlta SolicitudAlta[]

  @@map("escalafones")
}

model CodigoRegistro {
  id                     String          @id @default(uuid()) @db.Uuid
  codigo                 String          @unique @db.VarChar(10)
  literal                String          @db.VarChar(100)
  escalafonId            String          @map("escalafon_id") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  cargos                 Cargo[]
  escalafon              Escalafon       @relation(fields: [escalafonId], references: [id])
  concursosCphSolicitado ConcursoCph[]   @relation("CphCodigoRegistroSolicitado")
  solicitudesAlta        SolicitudAlta[]

  @@map("codigos_registro")
}

model Regimen {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String   @unique @db.VarChar(100)
  orden     Int
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cargos    Cargo[]

  @@map("regimenes")
}

model Persona {
  id                       String                  @id @default(uuid()) @db.Uuid
  cuil                     String                  @unique @db.VarChar(11)
  numeroDoc                String?                 @map("numero_doc") @db.VarChar(20)
  tipoDoc                  String?                 @map("tipo_doc") @db.VarChar(10)
  apellidoNombre           String                  @map("apellido_nombre") @db.VarChar(200)
  fechaNacimiento          DateTime?               @map("fecha_nacimiento") @db.Date
  sexo                     String?                 @db.VarChar(10)
  especialidadCph          String?                 @map("especialidad_cph") @db.VarChar(200)
  telefono                 String?                 @db.VarChar(20)
  mailPersonal             String?                 @map("mail_personal") @db.VarChar(255)
  mailLaboral              String?                 @map("mail_laboral") @db.VarChar(255)
  domicilio                String?                 @db.VarChar(255)
  localidad                String?                 @db.VarChar(150)
  provincia                String?                 @db.VarChar(100)
  antiguedadDesde          DateTime?               @map("antiguedad_desde") @db.Date
  activo                   Boolean                 @default(true)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  bajas                    Baja[]
  concursos                Concurso[]
  concursosCeetpsDesignado ConcursoCeetps[]        @relation("PersonaDesignadaCeetps")
  concursosCphDesignado    ConcursoCph[]           @relation("PersonaDesignadaCph")
  inscriptosConcurso       InscriptoConcurso[]
  juradosSorteados         MiembroJuradoSorteado[] @relation("MiembroJuradoPersona")
  ocupaciones              Ocupacion[]
  ordenMeritoIntegrante    OrdenMeritoIntegrante[]
  padronHistorico          PadronHistorico[]

  @@index([numeroDoc])
  @@index([especialidadCph])
  @@map("personas")
}

model Cargo {
  id                                             String              @id @default(uuid()) @db.Uuid
  idSial                                         String?             @unique @map("id_sial") @db.VarChar(50)
  codigo                                         String?             @unique @db.VarChar(30)
  hospitalId                                     String              @map("hospital_id") @db.Uuid
  escalafonId                                    String              @map("escalafon_id") @db.Uuid
  codigoRegistroId                               String?             @map("codigo_registro_id") @db.Uuid
  puestoCargoId                                  String              @map("puesto_cargo_id") @db.Uuid
  especialidadPuestoId                           String?             @map("especialidad_puesto_id") @db.Uuid
  literalPuesto                                  String?             @map("literal_puesto") @db.VarChar(200)
  especialidadLegacy                             String?             @map("especialidad_legacy") @db.VarChar(200)
  regimen                                        String?             @db.VarChar(50)
  codigoRepa                                     String?             @map("codigo_repa") @db.VarChar(20)
  descripcionRepa                                String?             @map("descripcion_repa") @db.VarChar(200)
  estado                                         EstadoCargo         @default(vigente)
  estadoDesde                                    DateTime?           @map("estado_desde") @db.Date
  expediente                                     String?             @db.VarChar(150)
  fechaDesde                                     DateTime?           @map("fecha_desde") @db.Date
  createdById                                    String?             @map("created_by_id") @db.Uuid
  createdAt                                      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                                      DateTime?           @map("deleted_at") @db.Timestamptz(6)
  tipoOrigen                                     String?             @map("tipo_origen") @db.VarChar(5)
  cargoRetenidoId                                String?             @map("cargo_retenido_id") @db.Uuid
  cargoBaseId                                    String?             @map("cargo_base_id") @db.Uuid
  periodoDesde                                   DateTime?           @map("periodo_desde") @db.Date
  periodoHasta                                   DateTime?           @map("periodo_hasta") @db.Date
  periodoRenovado                                Boolean             @default(false) @map("periodo_renovado")
  fechaRenovacion                                DateTime?           @map("fecha_renovacion") @db.Date
  docRenovacion                                  String?             @map("doc_renovacion")
  cesacId                                        String?             @map("cesac_id") @db.Uuid
  unidadFijaId                                   String?             @map("unidad_fija_id") @db.Uuid
  origen                                         String              @default("padron") @db.VarChar(15)
  revisionDato                                   Boolean             @default(false) @map("revision_dato")
  revisionMotivo                                 String?             @map("revision_motivo") @db.VarChar(200)
  regimenId                                      String?             @map("regimen_id") @db.Uuid
  subEstado                                      SubEstadoCargo?     @map("sub_estado")
  codigoLegacy                                   String?             @map("codigo_legacy")
  cargoEjecucionId                               String?             @map("cargo_ejecucion_id") @db.Uuid
  bajas                                          Baja[]
  cargoBase                                      Cargo?              @relation("CadenaCargo", fields: [cargoBaseId], references: [id])
  cadena                                         Cargo[]             @relation("CadenaCargo")
  cargoEjecucion                                 Cargo?              @relation("CargoEjecucion", fields: [cargoEjecucionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  jefaturas                                      Cargo[]             @relation("CargoEjecucion")
  cargoRetenido                                  Cargo?              @relation("CargoRemplazante", fields: [cargoRetenidoId], references: [id])
  remplazantes                                   Cargo[]             @relation("CargoRemplazante")
  cesac                                          Cesac?              @relation(fields: [cesacId], references: [id])
  codigoRegistro                                 CodigoRegistro?     @relation(fields: [codigoRegistroId], references: [id])
  createdBy                                      Usuario?            @relation("CargosCreados", fields: [createdById], references: [id])
  escalafon                                      Escalafon           @relation(fields: [escalafonId], references: [id])
  especialidadPuesto                             EspecialidadPuesto? @relation(fields: [especialidadPuestoId], references: [id])
  hospital                                       Hospital            @relation(fields: [hospitalId], references: [id])
  puestoCargo                                    PuestoCargo         @relation(fields: [puestoCargoId], references: [id])
  regimenRef                                     Regimen?            @relation(fields: [regimenId], references: [id])
  unidadFija                                     UnidadFijaApayC?    @relation(fields: [unidadFijaId], references: [id])
  concursos                                      Concurso[]
  concursosCeetps                                ConcursoCeetps[]
  concursosCph                                   ConcursoCph[]
  etiquetas                                      EtiquetaCargo[]
  ocupaciones                                    Ocupacion[]
  padronHistorico                                PadronHistorico[]
  padronIncidencias                              PadronIncidencia[]

  @@index([hospitalId])
  @@index([escalafonId])
  @@index([estado])
  @@index([subEstado])
  @@index([cargoBaseId])
  @@index([codigoLegacy])
  @@index([cargoRetenidoId])
  @@index([puestoCargoId])
  @@index([especialidadPuestoId])
  @@index([regimenId])
  @@index([cesacId])
  @@index([unidadFijaId])
  @@index([cargoEjecucionId])
  @@map("cargos")
}

model Ocupacion {
  id                    String          @id @default(uuid()) @db.Uuid
  personaId             String          @map("persona_id") @db.Uuid
  cargoId               String          @map("cargo_id") @db.Uuid
  idSialRol             String          @unique @map("id_sial_rol") @db.VarChar(50)
  cuil                  String?         @map("cuil") @db.VarChar(11)
  situacionRevista      String?         @map("situacion_revista") @db.VarChar(50)
  desde                 DateTime?       @db.Date
  hasta                 DateTime?       @db.Date
  codigoJefaturas       String?         @map("codigo_jefaturas") @db.VarChar(10)
  jefeEscalafon         String?         @map("jefe_escalafon") @db.VarChar(50)
  documentacionJefatura String?         @map("documentacion_jefatura")
  comentariosJefaturas  String?         @map("comentarios_jefaturas")
  escritorio            String?         @db.VarChar(100)
  pouDesde              DateTime?       @map("pou_desde") @db.Date
  documentacionPou      String?         @map("documentacion_pou")
  comision              String?         @db.VarChar(150)
  repaComision          String?         @map("repa_comision") @db.VarChar(200)
  srDocRespaldo         String?         @map("sr_doc_respaldo")
  srComentario          String?         @map("sr_comentario")
  crComentario          String?         @map("cr_comentario")
  fechaBloqueo          DateTime?       @map("fecha_bloqueo") @db.Date
  bloqueoComentario     String?         @map("bloqueo_comentario")
  bloqMotivo            String?         @map("bloq_motivo") @db.VarChar(200)
  codSituacion          String?         @map("cod_situacion") @db.VarChar(10)
  documentacionDelRol   String?         @map("documentacion_del_rol")
  documentacionBaja     String?         @map("documentacion_baja")
  cargoDesdeFecha       DateTime?       @map("cargo_desde") @db.Date
  cargoHastaFecha       DateTime?       @map("cargo_hasta") @db.Date
  snapshotId            String?         @map("snapshot_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  cargoJefaturaPuestoId String?         @map("cargo_jefatura_puesto_id") @db.Uuid
  cargo                 Cargo           @relation(fields: [cargoId], references: [id])
  cargoJefaturaPuesto   PuestoCargo?    @relation("OcupacionCargoJefatura", fields: [cargoJefaturaPuestoId], references: [id])
  persona               Persona         @relation(fields: [personaId], references: [id])
  snapshot              PadronSnapshot? @relation(fields: [snapshotId], references: [id])

  @@index([personaId])
  @@index([cargoId])
  @@index([hasta])
  @@index([cargoJefaturaPuestoId])
  @@map("ocupaciones")
}

model PadronSnapshot {
  id                   String             @id @default(uuid()) @db.Uuid
  fechaAsignada        DateTime           @unique @map("fecha_asignada") @db.Date
  filename             String             @db.VarChar(200)
  totalRegistros       Int                @map("total_registros")
  procesadoPorId       String?            @map("procesado_por") @db.Uuid
  estado               EstadoSnapshot     @default(pendiente)
  aprobadoPorId        String?            @map("aprobado_por") @db.Uuid
  aprobadoAt           DateTime?          @map("aprobado_at") @db.Timestamptz(6)
  pasoActual           String?            @map("paso_actual") @db.VarChar(100)
  errorMsg             String?            @map("error_msg")
  archivoResultadoPath String?            @map("archivo_resultado_path") @db.VarChar(500)
  archivoCalidadPath   String?            @map("archivo_calidad_path") @db.VarChar(500)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  ratioTamano          Float?             @map("ratio_tamano")
  advertenciaTamano    String?            @map("advertencia_tamano")
  bajasVinculadas      Baja[]             @relation("BajaSnapshotVinculado")
  ocupaciones          Ocupacion[]
  diffs                PadronDiff[]
  padronHistorico      PadronHistorico[]
  padronIncidencias    PadronIncidencia[]
  aprobadoPor          Usuario?           @relation("SnapshotAprobadoPor", fields: [aprobadoPorId], references: [id])
  procesadoPor         Usuario?           @relation("SnapshotProcesadoPor", fields: [procesadoPorId], references: [id])

  @@map("padron_snapshots")
}

model PadronDiff {
  id            String         @id @default(uuid()) @db.Uuid
  snapshotId    String         @map("snapshot_id") @db.Uuid
  tipo          TipoDiff
  idSialRol     String         @map("id_sial_rol") @db.VarChar(50)
  campo         String?        @db.VarChar(100)
  valorAnterior String?        @map("valor_anterior")
  valorNuevo    String?        @map("valor_nuevo")
  aprobado      Boolean?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  resolucion    String?        @map("resolucion") @db.VarChar(50)
  snapshot      PadronSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([snapshotId, idSialRol])
  @@map("padron_diff")
}

model PadronIncidencia {
  id             String         @id @default(uuid()) @db.Uuid
  snapshotId     String         @map("snapshot_id") @db.Uuid
  cargoId        String?        @map("cargo_id") @db.Uuid
  idSial         String?        @map("id_sial") @db.VarChar(50)
  idSialRol      String?        @map("id_sial_rol") @db.VarChar(50)
  tipo           String         @db.VarChar(40)
  estadoAnterior Json?          @map("estado_anterior")
  estadoNuevo    Json?          @map("estado_nuevo")
  detalle        String?
  resuelta       Boolean        @default(false)
  resolucion     String?        @db.VarChar(50)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  cargo          Cargo?         @relation(fields: [cargoId], references: [id])
  snapshot       PadronSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([cargoId])
  @@index([tipo])
  @@index([snapshotId, tipo])
  @@map("padron_incidencias")
}

model PadronHistorico {
  id               String         @id @default(uuid()) @db.Uuid
  snapshotId       String         @map("snapshot_id") @db.Uuid
  fechaAsignada    DateTime       @map("fecha_asignada") @db.Date
  personaId        String         @map("persona_id") @db.Uuid
  cargoId          String         @map("cargo_id") @db.Uuid
  idSialRol        String         @map("id_sial_rol") @db.VarChar(50)
  cuil             String?        @db.VarChar(11)
  escalafon        String?        @db.VarChar(50)
  hospitalSigla    String?        @map("hospital_sigla") @db.VarChar(20)
  literalPuesto    String?        @map("literal_puesto") @db.VarChar(200)
  especialidad     String?        @db.VarChar(200)
  situacionRevista String?        @map("situacion_revista") @db.VarChar(50)
  cargo            Cargo          @relation(fields: [cargoId], references: [id])
  persona          Persona        @relation(fields: [personaId], references: [id])
  snapshot         PadronSnapshot @relation(fields: [snapshotId], references: [id])

  @@index([snapshotId])
  @@index([fechaAsignada])
  @@index([personaId])
  @@index([cargoId])
  @@index([cuil])
  @@index([idSialRol, fechaAsignada])
  @@index([fechaAsignada, cargoId])
  @@map("padron_historico")
}

model Concurso {
  id              String          @id @default(uuid()) @db.Uuid
  personaId       String?         @map("persona_id") @db.Uuid
  cargoId         String          @map("cargo_id") @db.Uuid
  hospitalId      String          @map("hospital_id") @db.Uuid
  bajaId          String?         @map("baja_id") @db.Uuid
  origen          String          @db.VarChar(50)
  fechaVacante    DateTime        @map("fecha_vacante") @db.Date
  motivo          String?         @db.VarChar(200)
  expediente      String?         @db.VarChar(150)
  tipoConcurso    TipoConcurso?   @map("tipo_concurso")
  motivoConcurso  MotivoConcurso? @map("motivo_concurso")
  registradoPorId String?         @map("registrado_por") @db.Uuid
