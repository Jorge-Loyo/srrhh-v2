model DimCargaKpisPeriodo {
  id            Int            @id @default(autoincrement())
  sesionId      String         @map("sesion_id") @db.Uuid
  fechaCorte    DateTime       @map("fecha_corte") @db.Date
  anio          Int
  mes           Int
  codigoRegistro String?       @map("codigo_registro") @db.VarChar(10)
  efector       String?        @db.VarChar(20)
  totalActivos  Int            @default(0) @map("total_activos")
  totalVacantes Int            @default(0) @map("total_vacantes")
  totalNuevos   Int            @default(0) @map("total_nuevos")
  totalBajas    Int            @default(0) @map("total_bajas")
