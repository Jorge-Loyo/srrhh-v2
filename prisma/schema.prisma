// =============================================================================
// SRRHH v2 — Schema de Base de Datos
// Sistema de Recursos Humanos - Gobierno de la Ciudad de Buenos Aires
// =============================================================================
// Fuente de verdad del modelo de datos. Ver Doc/Contrato_Datos.md
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum EstadoCargo {
  vigente
  no_vigente
  validacion_vacante
}

enum EstadoSnapshot {
  procesando
  pendiente
  aprobado
  rechazado
  error
}

enum TipoDiff {
  nuevo
  modificado
  eliminado
}

enum TipoConcurso {
  cph
  ceetps
  sin_concurso
}

enum EstadoConcursoCph {
  no_iniciado
  activo
  finalizado
  suspendido
  desierto
}

enum EstadoConcursoCeetps {
  sin_autorizar
  autorizado
  en_proceso
  finalizado
  desierto
}

enum RolUsuario {
  admin
  editor
  viewer
  director
  concursales_cph
  concursales_ceetps
}

// =============================================================================
// TABLAS DE REFERENCIA (Catalogos)
// =============================================================================

model Hospital {
  id                  String   @id @default(uuid()) @db.Uuid
  sigla               String   @unique @db.VarChar(20)
  nombre              String   @db.VarChar(200)
  universoTotalizador String?  @map("universo_totalizador") @db.VarChar(100)
  tipo                String?  @db.VarChar(100)
  monovalencia        String?  @db.VarChar(100)
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  cargos           Cargo[]
  concursos        Concurso[]
  concursosCph     ConcursoCph[]
  concursosCeetps  ConcursoCeetps[]
  usuarios         Usuario[]
  bajas            Baja[]

  @@map("hospitales")
}

model Escalafon {
  id        String   @id @default(uuid()) @db.Uuid
  codigo    String   @unique @db.VarChar(20)
  nombre    String   @db.VarChar(100)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  codigosRegistro  CodigoRegistro[]
  cargos           Cargo[]
  concursosCeetps  ConcursoCeetps[]
  puestosCargo     PuestoCargo[]

  @@map("escalafones")
}

model CodigoRegistro {
  id          String   @id @default(uuid()) @db.Uuid
  codigo      String   @unique @db.VarChar(10)
  literal     String   @db.VarChar(100)
  escalafonId String   @map("escalafon_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  escalafon Escalafon @relation(fields: [escalafonId], references: [id])
  cargos    Cargo[]

  @@map("codigos_registro")
}

// =============================================================================
// ENTIDADES PRINCIPALES
// =============================================================================

model Persona {
  id                    String    @id @default(uuid()) @db.Uuid
  cuil                  String    @unique @db.VarChar(11)
  numeroDoc             String?   @map("numero_doc") @db.VarChar(20)
  tipoDoc               String?   @map("tipo_doc") @db.VarChar(10)
  apellidoNombre        String    @map("apellido_nombre") @db.VarChar(200)
  fechaNacimiento       DateTime? @map("fecha_nacimiento") @db.Date
  sexo                  String?   @db.VarChar(10)
  especialidadPrincipal String?   @map("especialidad_principal") @db.VarChar(200)
  // S2-17: contacto y domicilio
  telefono              String?   @db.VarChar(20)
  mailPersonal          String?   @map("mail_personal") @db.VarChar(255)
  mailLaboral           String?   @map("mail_laboral") @db.VarChar(255)
  domicilio             String?   @db.VarChar(255)
  localidad             String?   @db.VarChar(150)
  provincia             String?   @db.VarChar(100)
  antiguedadDesde       DateTime? @map("antiguedad_desde") @db.Date
  activo                Boolean   @default(true)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  ocupaciones              Ocupacion[]
  concursos                Concurso[]
  concursosCphDesignado    ConcursoCph[]    @relation("PersonaDesignadaCph")
  concursosCeetpsDesignado ConcursoCeetps[] @relation("PersonaDesignadaCeetps")
  padronHistorico          PadronHistorico[]
  bajas                    Baja[]

  @@index([numeroDoc])
  @@map("personas")
}

model Cargo {
  id                String       @id @default(uuid()) @db.Uuid
  idSial            String       @unique @map("id_sial") @db.VarChar(50)
  // Código interno del sistema (distinto del id_sial, que es del SIAL del
  // gobierno) — nomenclatura heredada del sistema legacy dotacion-rrhh
  // (Doc/REGLAS_NEGOCIO.MD ahí, sección 3): {CARRERA}[-{TIPO}][-{MODALIDAD}]-{seq 6 dígitos},
  // ej. "CPH-POU-000056". Se genera al backfillear los cargos reales
  // (2026-08-25) y debería generarse también en una futura función de "Alta
  // de Cargo" manual — no existe todavía en este proyecto, ver
  // Doc/Planificacion/PLAN_SCRUM_2026.md.
  codigo            String?      @unique @db.VarChar(30)
  hospitalId        String       @map("hospital_id") @db.Uuid
  escalafonId       String       @map("escalafon_id") @db.Uuid
  codigoRegistroId  String?      @map("codigo_registro_id") @db.Uuid
  literalPuesto     String?      @map("literal_puesto") @db.VarChar(200)
  especialidad      String?      @db.VarChar(200)
  agrupador         String?      @db.VarChar(150)
  unificadorPuesto  String?      @map("unificador_puesto") @db.VarChar(200)
  regimen           String?      @db.VarChar(50)
  // S2-17: repartición y clasificaciones SIAL
  codigoRepa        String?      @map("codigo_repa") @db.VarChar(20)
  descripcionRepa   String?      @map("descripcion_repa") @db.VarChar(200)
  codAgrupamiento   String?      @map("cod_agrupamiento") @db.VarChar(20)
  agrupamiento      String?      @db.VarChar(150)
  codFamilia        String?      @map("cod_familia") @db.VarChar(20)
  litFamilia        String?      @map("lit_familia") @db.VarChar(150)
  puestoCodigoSial  String?      @map("puesto_codigo_sial") @db.VarChar(20)
  estado            EstadoCargo  @default(vigente)
  // S8A-1: fecha en que el cargo entró al estado actual (para calcular días en estado)
  estadoDesde       DateTime?    @map("estado_desde") @db.Date
  // S7-1: trazabilidad del alta manual (RF-11/12/13)
  expediente        String?      @db.VarChar(150)
  fechaDesde        DateTime?    @map("fecha_desde") @db.Date
  createdById       String?      @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz

  // Relaciones
  hospital        Hospital        @relation(fields: [hospitalId], references: [id])
  escalafon       Escalafon       @relation(fields: [escalafonId], references: [id])
  codigoRegistro  CodigoRegistro? @relation(fields: [codigoRegistroId], references: [id])
  createdBy       Usuario?        @relation("CargosCreados", fields: [createdById], references: [id])
  ocupaciones     Ocupacion[]
  concursos       Concurso[]
  concursosCph    ConcursoCph[]
  concursosCeetps ConcursoCeetps[]
  padronHistorico PadronHistorico[]
  bajas           Baja[]

  @@index([hospitalId])
  @@index([escalafonId])
  @@index([estado])
  @@map("cargos")
}

model Ocupacion {
  id               String    @id @default(uuid()) @db.Uuid
  personaId        String    @map("persona_id") @db.Uuid
  cargoId          String    @map("cargo_id") @db.Uuid
  idSialRol             String    @unique @map("id_sial_rol") @db.VarChar(50)
  cuilYRol              String?   @map("cuil_y_rol") @db.VarChar(80)
  situacionRevista      String?   @map("situacion_revista") @db.VarChar(50)
  estadoPersona         String?   @map("estado_persona") @db.VarChar(50)
  desde                 DateTime? @db.Date
  hasta                 DateTime? @db.Date
  // S2-17: jefatura
  codigoJefaturas       String?   @map("codigo_jefaturas") @db.VarChar(10)
  jefeEscalafon         String?   @map("jefe_escalafon") @db.VarChar(50)
  documentacionJefatura String?   @map("documentacion_jefatura") @db.Text
  comentariosJefaturas  String?   @map("comentarios_jefaturas") @db.Text
  escritorio            String?   @db.VarChar(100)
  pouDesde              DateTime? @map("pou_desde") @db.Date
  documentacionPou      String?   @map("documentacion_pou") @db.Text
  // S2-17: comisión
  comision              String?   @db.VarChar(150)
  repaComision          String?   @map("repa_comision") @db.VarChar(200)
  srDocRespaldo         String?   @map("sr_doc_respaldo") @db.Text
  srComentario          String?   @map("sr_comentario") @db.Text
  crComentario          String?   @map("cr_comentario") @db.Text
  // S2-17: bloqueo
  fechaBloqueo          DateTime? @map("fecha_bloqueo") @db.Date
  bloqueoComentario     String?   @map("bloqueo_comentario") @db.Text
  bloqMotivo            String?   @map("bloq_motivo") @db.VarChar(200)
  codSituacion          String?   @map("cod_situacion") @db.VarChar(10)
  // S2-17: documentación del rol
  documentacionDelRol   String?   @map("documentacion_del_rol") @db.Text
  documentacionBaja     String?   @map("documentacion_baja") @db.Text
  // S2-17: días de guardia (una fila por día en origen → array)
  diasGuardia           String[]
  // cargo_desde / cargo_hasta: fechas del cargo en SIAL (CARGO_DESDE / CARGO_HASTA del Excel)
  cargoDesdeFecha       DateTime? @map("cargo_desde") @db.Date
  cargoHastaFecha       DateTime? @map("cargo_hasta") @db.Date
  snapshotId            String?   @map("snapshot_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  persona  Persona         @relation(fields: [personaId], references: [id])
  cargo    Cargo           @relation(fields: [cargoId], references: [id])
  snapshot PadronSnapshot? @relation(fields: [snapshotId], references: [id])

  @@index([personaId])
  @@index([cargoId])
  @@index([hasta])
  @@map("ocupaciones")
}

// =============================================================================
// PADRON SEMANAL
// =============================================================================

model PadronSnapshot {
  id             String         @id @default(uuid()) @db.Uuid
  fechaAsignada        DateTime       @unique @map("fecha_asignada") @db.Date
  filename             String         @db.VarChar(200)
  totalRegistros       Int            @map("total_registros")
  procesadoPorId       String?        @map("procesado_por") @db.Uuid
  estado               EstadoSnapshot @default(pendiente)
  aprobadoPorId        String?        @map("aprobado_por") @db.Uuid
  aprobadoAt           DateTime?      @map("aprobado_at") @db.Timestamptz
  pasoActual           String?        @map("paso_actual") @db.VarChar(100)
  errorMsg             String?        @map("error_msg") @db.Text
  // S2-16: rutas de archivos generados por el pipeline
  archivoResultadoPath String?        @map("archivo_resultado_path") @db.VarChar(500)
  archivoCalidadPath   String?        @map("archivo_calidad_path") @db.VarChar(500)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  procesadoPor    Usuario?          @relation("SnapshotProcesadoPor", fields: [procesadoPorId], references: [id])
  aprobadoPor     Usuario?          @relation("SnapshotAprobadoPor", fields: [aprobadoPorId], references: [id])
  diffs           PadronDiff[]
  ocupaciones     Ocupacion[]
  padronHistorico PadronHistorico[]

  @@map("padron_snapshots")
}

model PadronDiff {
  id            String   @id @default(uuid()) @db.Uuid
  snapshotId    String   @map("snapshot_id") @db.Uuid
  tipo          TipoDiff
  idSialRol     String   @map("id_sial_rol") @db.VarChar(50)
  campo         String?  @db.VarChar(100)
  valorAnterior String?  @map("valor_anterior") @db.Text
  valorNuevo    String?  @map("valor_nuevo") @db.Text
  aprobado      Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  snapshot PadronSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@map("padron_diff")
}

model PadronHistorico {
  id               String   @id @default(uuid()) @db.Uuid
  snapshotId       String   @map("snapshot_id") @db.Uuid
  fechaAsignada    DateTime @map("fecha_asignada") @db.Date
  personaId        String   @map("persona_id") @db.Uuid
  cargoId          String   @map("cargo_id") @db.Uuid
  idSialRol        String   @map("id_sial_rol") @db.VarChar(50)
  // Nullable: filas históricas de antes de S6-0 no lo tienen hasta que
  // corra el backfill (scripts/backfill-cuil-padron-historico.sql). Todo
  // registro nuevo (aprobarSnapshotService) ya lo completa siempre.
  cuil             String?  @db.VarChar(11)
  escalafon        String?  @db.VarChar(50)
  hospitalSigla    String?  @map("hospital_sigla") @db.VarChar(20)
  literalPuesto    String?  @map("literal_puesto") @db.VarChar(200)
  especialidad     String?  @db.VarChar(200)
  agrupador        String?  @db.VarChar(150)
  unificadorPuesto String?  @map("unificador_puesto") @db.VarChar(200)
  estadoPersona    String?  @map("estado_persona") @db.VarChar(50)
  situacionRevista String?  @map("situacion_revista") @db.VarChar(50)

  // Relaciones
  snapshot PadronSnapshot @relation(fields: [snapshotId], references: [id])
  persona  Persona        @relation(fields: [personaId], references: [id])
  cargo    Cargo          @relation(fields: [cargoId], references: [id])

  @@index([snapshotId])
  @@index([fechaAsignada])
  @@index([personaId])
  @@index([cargoId])
  @@index([cuil])
  @@map("padron_historico")
}

// =============================================================================
// CONCURSOS
// =============================================================================

model Concurso {
  id             String       @id @default(uuid()) @db.Uuid
  personaId      String?      @map("persona_id") @db.Uuid
  cargoId        String       @map("cargo_id") @db.Uuid
  hospitalId     String       @map("hospital_id") @db.Uuid
  // bajaId nullable: hay concursos por ampliación sin baja previa (S5-4)
  bajaId         String?      @map("baja_id") @db.Uuid
  origen         String       @db.VarChar(50)
  fechaVacante   DateTime     @map("fecha_vacante") @db.Date
  motivo         String?      @db.VarChar(200)
  expediente     String?      @db.VarChar(150)
  tipoConcurso   TipoConcurso @map("tipo_concurso")
  registradoPorId String?     @map("registrado_por") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  persona       Persona?         @relation(fields: [personaId], references: [id])
  cargo         Cargo            @relation(fields: [cargoId], references: [id])
  hospital      Hospital         @relation(fields: [hospitalId], references: [id])
  registradoPor Usuario?         @relation(fields: [registradoPorId], references: [id])
  concursoCph   ConcursoCph?
  concursoCeetps ConcursoCeetps?
  baja          Baja?            @relation(fields: [bajaId], references: [id])

  @@index([hospitalId])
  @@index([tipoConcurso])
  @@map("concursos")
}

model ConcursoCph {
  id                    String           @id @default(uuid()) @db.Uuid
  concursoId            String           @unique @map("concurso_id") @db.Uuid
  cargoId               String           @map("cargo_id") @db.Uuid
  hospitalId            String           @map("hospital_id") @db.Uuid
  // estado/subEstado/subEstado3: calculados por calcConcursoCph() (S4-4) en
  // cada create/PATCH, no editables directamente por el cliente (ver
  // concursos-cph.schema.ts) — se persisten igual (como el legacy) para poder
  // filtrar/indexar sin recalcular todo en cada listado. subEstado3 puede
  // desactualizarse solo con el paso del tiempo (dos ramas comparan contra
  // "hoy"), por eso el listado (S4-1) lo recalcula en SQL al filtrar en vez
  // de confiar ciegamente en el valor guardado — ver SUB_ESTADO_3_SQL_PG.
  estado                EstadoConcursoCph @default(no_iniciado)
  subEstado             String?          @map("sub_estado") @db.VarChar(50)
  subEstado3            String?          @map("sub_estado_3") @db.VarChar(50)
  especialidadSolicitada String?         @map("especialidad_solicitada") @db.VarChar(200)
  eeBaja                String?          @map("ee_baja") @db.VarChar(150)
  fechaBaja             DateTime?        @map("fecha_baja") @db.Date
  eeConcurso            String?          @map("ee_concurso") @db.VarChar(150)
  fechaEeConcurso       DateTime?        @map("fecha_ee_concurso") @db.Date
  fechaAutorizacion     DateTime?        @map("fecha_autorizacion") @db.Date
  sorteoJurado          DateTime?        @map("sorteo_jurado") @db.Date
  disposicion           String?          @db.VarChar(100)
  fechaInscDesde        DateTime?        @map("fecha_insc_desde") @db.Date
  fechaInscHasta        DateTime?        @map("fecha_insc_hasta") @db.Date
  fechaExamen           DateTime?        @map("fecha_examen") @db.Date
  fechaOrdenMerito      DateTime?        @map("fecha_orden_merito") @db.Date
  fechaIfacs            DateTime?        @map("fecha_ifacs") @db.Date
  fechaInsal            DateTime?        @map("fecha_insal") @db.Date
  eeDesignacion         String?          @map("ee_designacion") @db.VarChar(150)
  cargaDocumentacion    Boolean?         @map("carga_documentacion")
  fechaAptoMedico       DateTime?        @map("fecha_apto_medico") @db.Date
  fechaIte              DateTime?        @map("fecha_ite") @db.Date
  proyectoResolucion    Boolean?         @map("proyecto_resolucion")
  resoALaFirma          Boolean?         @map("reso_a_la_firma")
  resolucionDesignacion String?          @map("resolucion_designacion") @db.VarChar(100)
  fechaResolucion       DateTime?        @map("fecha_resolucion") @db.Date
  // Código real de cargo en SIAL — se completa cuando se da de alta la nueva
  // ocupación en SIAL tras la designación (paso administrativo posterior a
  // la resolución, distinto del cargoId/idSial del cargo vacante en concurso).
  cargoSial             String?          @map("cargo_sial") @db.VarChar(50)
  dispoDesierta         String?          @map("dispo_desierta") @db.VarChar(50)
  fechaDispoDesierta    DateTime?        @map("fecha_dispo_desierta") @db.Date
  personaDesignadaId    String?          @map("persona_designada_id") @db.Uuid
  suspendido            Boolean          @default(false)
  observaciones         String?          @db.Text
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  concurso         Concurso  @relation(fields: [concursoId], references: [id])
  cargo            Cargo     @relation(fields: [cargoId], references: [id])
  hospital         Hospital  @relation(fields: [hospitalId], references: [id])
  personaDesignada Persona?  @relation("PersonaDesignadaCph", fields: [personaDesignadaId], references: [id])

  @@index([hospitalId])
  @@index([estado])
  @@index([subEstado])
  // Partial unique index (no soportado por Prisma @@unique) — definido en
  // prisma/migrations/concurso_cph_unique_abierto/migration.sql:
  // CREATE UNIQUE INDEX ... WHERE estado NOT IN ('finalizado','desierto')
  // Garantiza que no haya dos concursos CPH abiertos para el mismo cargo
  // incluso ante requests concurrentes (race condition en createConcursoService).
  @@map("concursos_cph")
}

model ConcursoCeetps {
  id                    String              @id @default(uuid()) @db.Uuid
  concursoId            String              @unique @map("concurso_id") @db.Uuid
  cargoId               String              @map("cargo_id") @db.Uuid
  hospitalId            String              @map("hospital_id") @db.Uuid
  escalafonId           String              @map("escalafon_id") @db.Uuid
  estado                EstadoConcursoCeetps @default(sin_autorizar)
  expedienteConcurso    String?             @map("expediente_concurso") @db.VarChar(150)
  puestoSolicitado      String?             @map("puesto_solicitado") @db.VarChar(200)
  dispoLlamado          String?             @map("dispo_llamado") @db.VarChar(500)
  fechaIfacs            DateTime?           @map("fecha_ifacs") @db.Date
  fechaInsal            DateTime?           @map("fecha_insal") @db.Date
  expedienteDesignacion String?             @map("expediente_designacion") @db.VarChar(150)
  dispoDesignacion      String?             @map("dispo_designacion") @db.VarChar(500)
  resolucionDesignacion String?             @map("resolucion_designacion") @db.VarChar(500)
  personaDesignadaId    String?             @map("persona_designada_id") @db.Uuid
  observaciones         String?             @db.Text
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  concurso         Concurso  @relation(fields: [concursoId], references: [id])
  cargo            Cargo     @relation(fields: [cargoId], references: [id])
  hospital         Hospital  @relation(fields: [hospitalId], references: [id])
  escalafon        Escalafon @relation(fields: [escalafonId], references: [id])
  personaDesignada Persona?  @relation("PersonaDesignadaCeetps", fields: [personaDesignadaId], references: [id])

  @@index([hospitalId])
  @@index([escalafonId])
  @@index([estado])
  @@map("concursos_ceetps")
}

// =============================================================================
// BAJAS (S5-4)
// =============================================================================

enum EstadoBaja {
  resolucion_a_la_firma
  pendiente
  confirmada
  anulada
}

model Baja {
  id               String     @id @default(uuid()) @db.Uuid
  cargoId          String     @map("cargo_id") @db.Uuid
  hospitalId       String     @map("hospital_id") @db.Uuid
  personaId        String?    @map("persona_id") @db.Uuid
  // Fecha en que se produce la vacante
  fechaBaja        DateTime   @map("fecha_baja") @db.Date
  // Tipo de baja: campo libre (97% vacío en datos reales — ver análisis CSV
  // en PLAN_SCRUM_2026.md POST-SPRINT 4 (4)). Lista sugerida en el frontend
  // pero no obligatoria: Cargo retenido, Interino, Jubilación, etc.
  tipoBaja         String?    @map("tipo_baja") @db.VarChar(100)
  motivo           String?    @db.VarChar(500)
  // Tipificador de origen (ej. "Bajas 2025", "Ampliación 2026", "Art. 48")
  // — campo libre importante para trazabilidad, ver análisis CSV.
  tipificadorOrigen String?   @map("tipificador_origen") @db.VarChar(200)
  // Si genera concurso, se crea automáticamente en S5-5
  eeBaja                String?  @map("ee_baja") @db.VarChar(500)
  partidaPresupuestaria String?  @map("partida_presupuestaria") @db.VarChar(100)
  docRespaldatoria      String?  @map("doc_respaldatoria") @db.VarChar(500)
  fechaPaseParalelo     DateTime? @map("fecha_pase_paralelo") @db.Date
  generaConcurso        Boolean  @default(true) @map("genera_concurso")
  estado           EstadoBaja @default(pendiente)
  observaciones    String?    @db.Text
  registradoPorId  String?    @map("registrado_por") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  cargo           Cargo     @relation(fields: [cargoId], references: [id])
  hospital        Hospital  @relation(fields: [hospitalId], references: [id])
  persona         Persona?  @relation(fields: [personaId], references: [id])
  registradoPor   Usuario?  @relation(fields: [registradoPorId], references: [id])
  // baja_id nullable en ConcursoCph: hay concursos por ampliación sin baja
  // previa (22% de los datos reales — ver análisis CSV)
  concursos       Concurso[]

  @@index([cargoId])
  @@index([hospitalId])
  @@index([estado])
  @@map("bajas")
}

// =============================================================================
// SEGURIDAD Y AUDITORIA
// =============================================================================

model Usuario {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(64)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  rol          RolUsuario
  hospitalId   String?    @map("hospital_id") @db.Uuid
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  hospital              Hospital?        @relation(fields: [hospitalId], references: [id])
  refreshTokens         RefreshToken[]
  snapshotsProcesados   PadronSnapshot[] @relation("SnapshotProcesadoPor")
  snapshotsAprobados    PadronSnapshot[] @relation("SnapshotAprobadoPor")
  concursosRegistrados  Concurso[]
  auditLogs             AuditLog[]
  bajasRegistradas      Baja[]
  cargosCreados         Cargo[]          @relation("CargosCreados")

  @@map("usuarios")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  familyId  String    @map("family_id") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revocado  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  accion     String   @db.VarChar(32)
  entidad    String   @db.VarChar(64)
  entidadId  String?  @map("entidad_id") @db.VarChar(64)
  cambios    Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relaciones
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([entidad])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// CATALOGOS (S2-14 / S2-15)
// =============================================================================

model Especialidad {
  id          String  @id @default(uuid()) @db.Uuid
  nombre      String  @unique @db.VarChar(200)
  prioritaria Boolean @default(false)
  activo      Boolean @default(true)

  @@map("especialidades")
}

model Puesto {
  id     String  @id @default(uuid()) @db.Uuid
  nombre String  @unique @db.VarChar(200)
  activo Boolean @default(true)

  @@map("puestos")
}

enum ModalidadPuesto {
  pof
  pou
  ambos
}

model PuestoCargo {
  id          String          @id @default(uuid()) @db.Uuid
  escalafonId String          @map("escalafon_id") @db.Uuid
  modalidad   ModalidadPuesto
  nombre      String          @db.VarChar(200)
  activo      Boolean         @default(true)

  escalafon      Escalafon            @relation(fields: [escalafonId], references: [id])
  especialidades EspecialidadPuesto[]

  @@unique([escalafonId, modalidad, nombre])
  @@index([escalafonId, modalidad])
  @@map("puestos_cargo")
}

model EspecialidadPuesto {
  id           String     @id @default(uuid()) @db.Uuid
  puestoCargId String     @map("puesto_cargo_id") @db.Uuid
  nombre       String     @db.VarChar(200)
  activo       Boolean    @default(true)

  puesto PuestoCargo @relation(fields: [puestoCargId], references: [id], onDelete: Cascade)

  @@unique([puestoCargId, nombre])
  @@index([puestoCargId])
  @@map("especialidades_puesto")
}

// =============================================================================
// TABLAS DE REFERENCIA (Mapeos Dotaneitor)
// =============================================================================

model RefAgrupador {
  id         String  @id @default(uuid()) @db.Uuid
  cruce      String  @unique @db.VarChar(300)
  escalafon  String  @db.VarChar(150)
  litPuesto  String  @map("lit_puesto") @db.VarChar(200)
