# Dockerfile de PRODUCCIÓN para @srrhh/web — build estático (Vite) servido
# por nginx. En dev el frontend corre nativo en Windows (ver
# Doc/ARRANQUE_LOCAL.md sección 4) — este Dockerfile es solo para producción.
#
# VITE_API_URL se hornea en el bundle en build-time (así funciona Vite, no es
# una env var que se pueda cambiar en runtime) — se lo pasa docker-compose.prod.yml
# como build arg, normalmente vacío/relativo si Caddy sirve todo bajo el mismo
# dominio (/api/* proxeado ahí, ver Caddyfile), o la URL completa si la API
# vive en otro dominio.

# ── Stage 1: build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS build

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/utils/package.json packages/utils/package.json
COPY prisma ./prisma

RUN pnpm install --frozen-lockfile

COPY apps/web apps/web
COPY packages packages

ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

WORKDIR /repo/apps/web
RUN pnpm run build

# ── Stage 2: nginx ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

COPY apps/web/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html

EXPOSE 80
